#!/bin/bash

set -euo pipefail

DEPLOYMENT_ID=$(echo "$CONTEXT" | jq -r '.scope.current_active_deployment // empty')

if [[ -z "$DEPLOYMENT_ID" ]]; then
  log error "❌ The scope has no active deployment, so there is no scheduled job to trigger"
  log error ""
  log error "💡 Possible causes:"
  log error "   The scope has not been deployed yet"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Deploy the scope first, then trigger the job"
  log error ""
  exit 1
fi

K8S_NAMESPACE=$(echo "$CONTEXT" | jq -r --arg default "${K8S_NAMESPACE:-nullplatform}" '
  .providers["container-orchestration"].cluster.namespace // $default
')

SCOPE_ID=$(echo "$CONTEXT" | jq -r '.scope.id')

# Scheduled scopes have a CronJob to spawn a Job from. Run-once scopes don't —
# they leave behind the last Job of the scope, which we clone to re-run.
CRONJOB_LOOKUP_STATUS=0
CRONJOB_NAMES=$(np_naming_list_by_label cronjob "$K8S_NAMESPACE" "scope_id=$SCOPE_ID") || CRONJOB_LOOKUP_STATUS=$?
CRONJOB="${CRONJOB_NAMES%% *}"

if [ "$CRONJOB_LOOKUP_STATUS" -eq 1 ]; then
  log error "❌ Could not check the cluster for the scope's CronJob in namespace '$K8S_NAMESPACE'"
  log error ""
  log error "💡 Possible causes:"
  log error "   - The cluster API server is unreachable"
  log error "   - RBAC denies reading cronjob in namespace '$K8S_NAMESPACE'"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Verify cluster connectivity and RBAC: kubectl auth can-i get cronjob -n $K8S_NAMESPACE"
  log error ""
  exit 1
fi

if [ "$CRONJOB_LOOKUP_STATUS" -eq 0 ]; then
  log info "📝 Triggering job $CRONJOB"
  kubectl create job --from="cronjob/$CRONJOB" "$CRONJOB-$(date +%s)" -n "$K8S_NAMESPACE"
  log info "✅ The job $CRONJOB was triggered, you can follow the execution from the logs screen"
  exit 0
fi

# Run-once: clone the most recent Job of the scope into a fresh one. Sorting by
# creationTimestamp and taking the last item gives the latest run.
JOB_LOOKUP_STATUS=0
LAST_JOB=$(kubectl get job -n "$K8S_NAMESPACE" -l "scope_id=$SCOPE_ID" --sort-by=.metadata.creationTimestamp -o jsonpath="{.items[-1:].metadata.name}" 2>/dev/null) || JOB_LOOKUP_STATUS=$?

if [ "$JOB_LOOKUP_STATUS" -ne 0 ]; then
  log error "❌ Could not check the cluster for the scope's previous Job in namespace '$K8S_NAMESPACE'"
  log error ""
  log error "💡 Possible causes:"
  log error "   - The cluster API server is unreachable"
  log error "   - RBAC denies reading job in namespace '$K8S_NAMESPACE'"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Verify cluster connectivity and RBAC: kubectl auth can-i get job -n $K8S_NAMESPACE"
  log error ""
  exit 1
fi

if [[ -z "$LAST_JOB" ]]; then
  log error "❌ No CronJob or previous Job found for scope '$SCOPE_ID' in namespace '$K8S_NAMESPACE'"
  log error ""
  log error "💡 Possible causes:"
  log error "   The scope's job may not have been created yet, or the deployment is still in progress"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Verify a job exists: kubectl get job -n $K8S_NAMESPACE -l scope_id=$SCOPE_ID"
  log error "   • Redeploy the scope if no job is present"
  log error ""
  exit 1
fi

NEW_JOB="job-$SCOPE_ID-$(date +%s)"

log info "📝 Re-running job $LAST_JOB as $NEW_JOB"

# Clone the Job: drop server-managed fields and the controller-generated
# selector/labels, otherwise the API rejects the create.
kubectl get job "$LAST_JOB" -n "$K8S_NAMESPACE" -o json | jq \
  --arg name "$NEW_JOB" \
  --argjson controller_labels '["controller-uid", "batch.kubernetes.io/controller-uid", "job-name", "batch.kubernetes.io/job-name"]' '
    .metadata |= {name: $name, namespace: .namespace, labels: (.labels // {})}
    | del(.metadata.labels[$controller_labels[]], .spec.template.metadata.labels[$controller_labels[]])
    | del(.status)
    | del(.spec.selector)
    | del(.spec.template.metadata.creationTimestamp)
  ' | kubectl create -n "$K8S_NAMESPACE" -f -

log info "✅ The job $NEW_JOB was triggered, you can follow the execution from the logs screen"
