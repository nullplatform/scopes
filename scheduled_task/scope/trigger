#!/bin/bash

set -euo pipefail

DEPLOYMENT_ID=$(echo "$CONTEXT" | jq -r '.scope.current_active_deployment // empty')

if [[ -z "$DEPLOYMENT_ID" ]]; then
  log error "❌ The scope has no active deployment, so there is no scheduled job to trigger"
  log error ""
  log error "💡 Possible causes:"
  log error "   The scope has not been deployed yet"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Deploy the scope first, then trigger the job"
  log error ""
  exit 1
fi

K8S_NAMESPACE=$(echo "$CONTEXT" | jq -r --arg default "${K8S_NAMESPACE:-nullplatform}" '
  .providers["container-orchestration"].cluster.namespace // $default
')

SCOPE_ID=$(echo "$CONTEXT" | jq -r '.scope.id')

JOB_LOOKUP_STATUS=0
JOB_NAMES=$(np_naming_list_by_label cronjob "$K8S_NAMESPACE" "scope_id=$SCOPE_ID") || JOB_LOOKUP_STATUS=$?
JOB="${JOB_NAMES%% *}"

if [ "$JOB_LOOKUP_STATUS" -eq 1 ]; then
  log error "❌ Could not check the cluster for the scope's CronJob in namespace '$K8S_NAMESPACE'"
  log error ""
  log error "💡 Possible causes:"
  log error "   - The cluster API server is unreachable"
  log error "   - RBAC denies reading cronjob in namespace '$K8S_NAMESPACE'"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Verify cluster connectivity and RBAC: kubectl auth can-i get cronjob -n $K8S_NAMESPACE"
  log error ""
  exit 1
fi

if [[ -z "$JOB" ]]; then
  log error "❌ No CronJob found for scope '$SCOPE_ID' in namespace '$K8S_NAMESPACE'"
  log error ""
  log error "💡 Possible causes:"
  log error "   The scope's scheduled job may not have been created yet, or the deployment is still in progress"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Verify the CronJob exists: kubectl get cronjob -n $K8S_NAMESPACE -l scope_id=$SCOPE_ID"
  log error "   • Redeploy the scope if the CronJob is missing"
  log error ""
  exit 1
fi

log info "📝 Triggering job $JOB"

kubectl create job --from="cronjob/$JOB" "$JOB-$(date +%s)" -n "$K8S_NAMESPACE"

log info "✅ The job $JOB was triggered, you can follow the execution from the logs screen"
