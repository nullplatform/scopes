#!/bin/bash
# Lists the metrics the resolved source offers (sources/<source>/list).
# shellcheck source=/dev/null
case "$METRICS_SOURCE" in
  prometheus|datadog) ;;
  *)
    echo "METRICS_SOURCE must be prometheus or datadog (build_context must run first), got '$METRICS_SOURCE'." >&2
    exit 1
    ;;
esac
. "$SERVICE_PATH/metric/sources/$METRICS_SOURCE/list"
