#!/bin/bash

SCOPE_ID=$(echo "$CONTEXT" | jq -r '.arguments.scope_id // empty')
K8S_NAMESPACE=${K8S_NAMESPACE:-"nullplatform"}

source "$SERVICE_PATH/utils/get_config_value"

read_scope_nrn() {
  local scope
  scope=$(np scope read --id "$SCOPE_ID" --format json) || return 1
  echo "$scope" | jq -r .nrn
}

resolve_traffic_proxy() {
  local nrn="${NRN-}"
  if [[ -z "$nrn" ]]; then
    nrn=$(read_scope_nrn) || return 1
  fi
  local providers
  providers=$(np provider list --categories scope-configurations --nrn "$nrn" --format json) || {
    echo "Could not read the scope-configurations provider to resolve TRAFFIC_PROXY." >&2
    return 1
  }
  local provider_context
  provider_context=$(echo "$providers" | jq -c '{providers: {"scope-configurations": (.results[0].attributes // {})}}') || return 1

  local value
  value=$(CONTEXT="$provider_context" get_config_value \
    --env TRAFFIC_PROXY \
    --provider '.providers["scope-configurations"].deployment.traffic_proxy' \
    --default "nginx"
  )

  if [[ "$value" != "nginx" && "$value" != "istio" ]]; then
    echo "TRAFFIC_PROXY must be 'nginx' or 'istio', got: '$value'" >&2
    return 1
  fi

  echo "$value"
}

if [[ -z "$PROMETHEUS_URL" ]]; then
  NRN=$(read_scope_nrn)

  PROVIDERS=$(np provider list --categories metrics --nrn "$NRN" --format json)

  PROM_URL=$(echo "$PROVIDERS" | jq -r '.results[0].attributes.server.url // empty')
else
  PROM_URL="$PROMETHEUS_URL"
fi

if [[ -z "$PROM_URL" ]]; then
  echo "There is no prometheus provider configured. Please configure prometheus in Platform settings and try again." >&2
  exit 1
fi

while read -r line; do
  eval "$line"
done < <(echo "$CONTEXT" | jq -r '.arguments | to_entries[] |
  if (.value | type) == "array" then
    "export \(.key | ascii_upcase)=\(.value | join(","))"
  else
    "export \(.key | ascii_upcase)=\(.value)"
  end')
if [[ -n "$METRIC" ]]; then
  export METRIC_NAME="$METRIC"
fi

if [[ "$METRIC_NAME" == "http.healthcheck_count" || "$METRIC_NAME" == "http.healthcheck_fail" ]]; then
  TRAFFIC_PROXY=$(resolve_traffic_proxy) || exit 1
  export TRAFFIC_PROXY
fi

export PROM_URL
export K8S_NAMESPACE
export SCOPE_ID