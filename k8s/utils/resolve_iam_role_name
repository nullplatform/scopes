#!/bin/bash

_RESOLVE_IAM_ROLE_NAME_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
if [[ "$(type -t np_name_render 2>/dev/null)" != "function" ]]; then
  source "$_RESOLVE_IAM_ROLE_NAME_DIR/../naming/resolve_names"
fi

IAM_ROLE_NAME_BUDGET=64

_iam_service_account_of_scope() {
  kubectl get serviceaccounts -n "$1" -l "scope_id=$2" \
    -o jsonpath='{.items[*].metadata.name}' 2>/dev/null || return 1
}

_iam_role_scope_id() {
  aws iam get-role --role-name "$1" \
    --query "Role.Tags[?Key=='scope_id'].Value | [0]" --output text 2>/dev/null || true
}

IAM_GKE_SERVICE_ACCOUNT_NAME_MAX=63

# IAM.MODE gke shares one Kubernetes service account among the scopes of an
# application in an environment, so a service can grant it access when it is
# linked, before the scope exists: np-<application id>-<environment>, where the
# environment is the scope's "environment" dimension lowercased. The value is
# never rewritten or truncated (two environments must never map to one name):
# one that is not a DNS-1123 label, or a name over 63 characters, fails.
# IAM.PREFIX is not used and AWS is never asked. Sets IAM_ROLE_NAME and
# IAM_GKE_ENVIRONMENT.
_iam_gke_service_account_name() {
  local application_id environment name
  application_id=$(echo "${CONTEXT:-}" | jq -r '.application.id // empty')
  environment=$(echo "${CONTEXT:-}" | jq -r '.scope.dimensions.environment // empty' | LC_ALL=C tr '[:upper:]' '[:lower:]')

  if [ -z "$environment" ]; then
    log error "❌ Could not name the service account of scope $1: IAM.MODE gke needs the scope's 'environment' dimension"
    log error "💡 Possible causes:"
    log error "   The scope has no 'environment' dimension"
    log error "🔧 How to fix:"
    log error "   • Create the scope with an 'environment' dimension, or set IAM.MODE to irsa or pod_identity"
    return 1
  fi
  if [ -z "$application_id" ]; then
    log error "❌ Could not name the service account of scope $1: the context has no application id"
    log error "🔧 How to fix:"
    log error "   • Check that the scope belongs to an application"
    return 1
  fi
  if ! [[ "$environment" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
    log error "❌ Could not name the service account of scope $1: environment '$environment' is not a valid Kubernetes name"
    log error "💡 Possible causes:"
    log error "   IAM.MODE gke uses the 'environment' dimension, lowercased, as is: only letters, digits and inner hyphens are allowed"
    log error "🔧 How to fix:"
    log error "   • Use an 'environment' dimension value made of letters, digits and hyphens, starting and ending with a letter or digit"
    return 1
  fi

  name="np-$application_id-$environment"
  if [ "${#name}" -gt "$IAM_GKE_SERVICE_ACCOUNT_NAME_MAX" ]; then
    log error "❌ Could not name the service account of scope $1: '$name' has ${#name} characters, over $IAM_GKE_SERVICE_ACCOUNT_NAME_MAX"
    log error "🔧 How to fix:"
    log error "   • Use a shorter 'environment' dimension value (up to $((IAM_GKE_SERVICE_ACCOUNT_NAME_MAX - ${#application_id} - 4)) characters for application $application_id)"
    return 1
  fi

  # shellcheck disable=SC2034  # read by build_service_account
  IAM_GKE_ENVIRONMENT="$environment"
  IAM_ROLE_NAME="$name"
}

resolve_iam_role_name() {
  local prefix="$1" scope_id="$2" namespace="$3" mode="${4:-irsa}" name

  if [ "$mode" = "gke" ]; then
    _iam_gke_service_account_name "$scope_id"
    return
  fi

  if [[ "$prefix" != *"{"* ]]; then
    IAM_ROLE_NAME="$prefix-$scope_id"
    return 0
  fi

  if ! name=$(_iam_service_account_of_scope "$namespace" "$scope_id"); then
    log error "❌ Could not look up the service account of scope $scope_id in namespace '$namespace'"
    log error "🔧 How to fix:"
    log error "   • Check that the agent can list serviceaccounts in '$namespace'"
    return 1
  fi
  name="${name%% *}"
  if [ -n "$name" ]; then
    if [ "$(_iam_role_scope_id "$name")" = "$scope_id" ]; then
      IAM_ROLE_NAME="$name"
      return 0
    fi
    log warn "⚠️  Ignoring service account '$name': its IAM role is not tagged with scope_id=$scope_id"
  fi

  if ! name=$(np_name_render "$((IAM_ROLE_NAME_BUDGET - ${#scope_id} - 1))" "$prefix"); then
    log error "❌ Could not render the IAM role name from prefix '$prefix'"
    log error "🔧 How to fix:"
    log error "   • Fix IAM.PREFIX; see k8s/docs/resource-naming.md"
    return 1
  fi

  IAM_ROLE_NAME="$name-$scope_id"
}
