#!/bin/bash

# Copies image pull secrets into the namespace a scope deploys to.
#
# imagePullSecrets are namespace-local: the pod only finds them in its own namespace.
# With K8S_NAMESPACE_STRATEGY other than static, workloads leave the namespace that holds
# the registry credentials, so they are copied there on every deploy (a rotated source
# credential reaches the copies on the next deploy).
#
# Usage: sync_image_pull_secrets <pull_secrets_json> <target_namespace>
#   pull_secrets_json: {"ENABLED": true, "SECRETS": ["name", ...]} or ["name", ...]
#
# Configuration:
#   IMAGE_PULL_SECRETS_SYNC      / security.image_pull_secrets_sync      (default: true)
#     set to false when an external controller (e.g. Kyverno) keeps the copies in sync
#   PULL_SECRET_SOURCE_NAMESPACE / security.pull_secret_source_namespace (default: static namespace)

source "$(dirname "${BASH_SOURCE[0]}")/resolve_k8s_namespace"

SYNCED_FROM_LABEL="nullplatform.com/synced-from"

sync_image_pull_secrets() {
  local pull_secrets="$1" target_namespace="$2" secret_names sync_enabled source_namespace secret_name secret secret_type registries

  secret_names=$(echo "${pull_secrets:-null}" | jq -r '
    if type == "array" then .[]
    elif type == "object" and .ENABLED == true then (.SECRETS // [])[]
    else empty end' 2>/dev/null)
  [ -z "$secret_names" ] && return 0

  sync_enabled=$(get_config_value \
    --env IMAGE_PULL_SECRETS_SYNC \
    --provider '.providers["scope-configurations"].security.image_pull_secrets_sync' \
    --default "true"
  )
  [ "$sync_enabled" != "true" ] && return 0

  source_namespace=$(get_config_value \
    --env PULL_SECRET_SOURCE_NAMESPACE \
    --provider '.providers["scope-configurations"].security.pull_secret_source_namespace' \
    --default "$(static_k8s_namespace)"
  )
  [ "$source_namespace" = "$target_namespace" ] && return 0

  while IFS= read -r secret_name; do
    [ -z "$secret_name" ] && continue

    if ! secret=$(kubectl get secret "$secret_name" -n "$source_namespace" -o json 2>/dev/null); then
      log warn "⚠️  Pull secret '$secret_name' not found in namespace '$source_namespace'; skipping it (expected when nodes pull images with IAM)"
      continue
    fi

    secret_type=$(echo "$secret" | jq -r '.type // empty')
    if [ "$secret_type" != "kubernetes.io/dockerconfigjson" ] && [ "$secret_type" != "kubernetes.io/dockercfg" ]; then
      log warn "⚠️  Secret '$secret_name' in namespace '$source_namespace' is of type '${secret_type:-none}', not an image pull secret; skipping it"
      continue
    fi

    registries=$(echo "$secret" | jq -r '
      (.data[".dockerconfigjson"] // empty | @base64d | fromjson | .auths // {} | keys[]) // empty' 2>/dev/null)
    if echo "$registries" | grep -qE '\.dkr\.ecr\.[a-z0-9-]+\.amazonaws\.com'; then
      log warn "⚠️  Pull secret '$secret_name' holds an ECR token, which expires every 12h: its copy in '$target_namespace' is only refreshed on each deploy"
      log warn "   • Prefer pulling with IAM, or keep copies in sync continuously (see k8s/docs/image-pull-secrets.md)"
    fi

    log debug "📝 Syncing pull secret '$secret_name' from '$source_namespace' to '$target_namespace'..."

    if ! echo "$secret" | jq --arg label "$SYNCED_FROM_LABEL" --arg source "$source_namespace" '
        del(.metadata.namespace, .metadata.uid, .metadata.resourceVersion, .metadata.creationTimestamp,
            .metadata.ownerReferences, .metadata.selfLink, .metadata.managedFields,
            .metadata.annotations["kubectl.kubernetes.io/last-applied-configuration"])
        | .metadata.labels[$label] = $source' \
        | kubectl apply -n "$target_namespace" -f - >/dev/null; then
      log error "   ❌ Failed to sync pull secret '$secret_name' to namespace '$target_namespace'"
      log error ""
      log error "💡 Possible causes:"
      log error "   • The agent cannot create secrets in namespace '$target_namespace'"
      log error ""
      log error "🔧 How to fix:"
      log error "   • Grant the agent create/patch on secrets cluster-wide, or set IMAGE_PULL_SECRETS_SYNC=false and sync them externally"
      log error ""
      return 1
    fi

    log info "   ✅ Pull secret '$secret_name' synced to '$target_namespace'"
  done <<< "$secret_names"
}
