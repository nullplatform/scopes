#!/bin/bash

set -euo pipefail


DEPLOYMENT_ID=$(echo "$CONTEXT" | jq .scope.current_active_deployment -r)
SCOPE_ID=$(echo "$CONTEXT" | jq .scope.id -r)

K8S_NAMESPACE=$(echo "$CONTEXT" | jq -r --arg default "$K8S_NAMESPACE" '
  .providers["container-orchestration"].cluster.namespace // $default
')

HPA_NAME=$(np_naming_lookup hpa "$K8S_NAMESPACE" "$DEPLOYMENT_ID") || {
  log error "❌ No HPA found for deployment $DEPLOYMENT_ID in namespace '$K8S_NAMESPACE'"
  log error "💡 Possible causes:"
  log error "   - Autoscaling is not configured for this deployment"
  log error "🔧 How to fix:"
  log error "   • Verify the HPA exists: kubectl get hpa -n $K8S_NAMESPACE -l deployment_id=$DEPLOYMENT_ID"
  exit 1
}

ANNOTATION_DATA=$(kubectl get hpa "$HPA_NAME" -n "$K8S_NAMESPACE" -o jsonpath='{.metadata.annotations.nullplatform\.com/autoscaling-paused}' 2>/dev/null || echo "")

if [[ -z "$ANNOTATION_DATA" || "$ANNOTATION_DATA" == "null" ]]; then
    log info "   ✅ HPA '$HPA_NAME' is already active, no action needed"
    exit 0
fi

ORIGINAL_MIN=$(echo "$ANNOTATION_DATA" | jq -r '.originalMinReplicas')
ORIGINAL_MAX=$(echo "$ANNOTATION_DATA" | jq -r '.originalMaxReplicas')

PAUSED_AT=$(echo "$ANNOTATION_DATA" | jq -r '.pausedAt')

log debug "📋 Found paused HPA configuration:"
log debug "   Original min replicas: $ORIGINAL_MIN"
log debug "   Original max replicas: $ORIGINAL_MAX"
log debug "   Paused at: $PAUSED_AT"

log debug "📝 Resuming autoscaling..."

PATCH=$(jq -n \
  --argjson originalMin "$ORIGINAL_MIN" \
  --argjson originalMax "$ORIGINAL_MAX" \
  '{
    metadata: {
      annotations: {
        "nullplatform.com/autoscaling-paused": null
      }
    },
    spec: {
      minReplicas: $originalMin,
      maxReplicas: $originalMax
    }
  }')

kubectl patch hpa "$HPA_NAME" -n "$K8S_NAMESPACE" --type='merge' -p "$PATCH"

log info ""
log info "✅ Autoscaling resumed successfully"
log debug "   HPA: $HPA_NAME"
log debug "   Namespace: $K8S_NAMESPACE"
log debug "   Min replicas: $ORIGINAL_MIN"
log debug "   Max replicas: $ORIGINAL_MAX"
