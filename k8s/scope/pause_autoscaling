#!/bin/bash

set -euo pipefail


DEPLOYMENT_ID=$(echo "$CONTEXT" | jq .scope.current_active_deployment -r)
SCOPE_ID=$(echo "$CONTEXT" | jq .scope.id -r)

K8S_NAMESPACE=$(echo "$CONTEXT" | jq -r --arg default "$K8S_NAMESPACE" '
  .providers["container-orchestration"].cluster.namespace // $default
')

HPA_NAME=$(np_naming_lookup hpa "$K8S_NAMESPACE" "$DEPLOYMENT_ID") || {
  log error "❌ No HPA found for deployment $DEPLOYMENT_ID in namespace '$K8S_NAMESPACE'"
  log error "💡 Possible causes:"
  log error "   - Autoscaling is not configured for this deployment"
  log error "🔧 How to fix:"
  log error "   • Verify the HPA exists: kubectl get hpa -n $K8S_NAMESPACE -l deployment_id=$DEPLOYMENT_ID"
  exit 1
}

CURRENT_CONFIG=$(kubectl get hpa "$HPA_NAME" -n "$K8S_NAMESPACE" -o json)
CURRENT_MIN=$(echo "$CURRENT_CONFIG" | jq -r '.spec.minReplicas')
CURRENT_MAX=$(echo "$CURRENT_CONFIG" | jq -r '.spec.maxReplicas')

log debug "📋 Current HPA configuration:"
log debug "   Min replicas: $CURRENT_MIN"
log debug "   Max replicas: $CURRENT_MAX"

DEPLOYMENT_NAME=$(np_naming_lookup deployment "$K8S_NAMESPACE" "$DEPLOYMENT_ID") || {
  log error "❌ No deployment found for deployment $DEPLOYMENT_ID in namespace '$K8S_NAMESPACE'"
  log error "💡 Possible causes:"
  log error "   - The deployment was not created yet or was deleted"
  log error "🔧 How to fix:"
  log error "   • Verify the deployment exists: kubectl get deployment -n $K8S_NAMESPACE -l deployment_id=$DEPLOYMENT_ID"
  exit 1
}
CURRENT_REPLICAS=$(kubectl get deployment "$DEPLOYMENT_NAME" -n "$K8S_NAMESPACE" -o jsonpath='{.spec.replicas}')

log debug "📋 Current deployment replicas: $CURRENT_REPLICAS"
log debug "📝 Pausing autoscaling at $CURRENT_REPLICAS replicas..."

PATCH=$(jq -n \
  --arg originalMin "$CURRENT_MIN" \
  --arg originalMax "$CURRENT_MAX" \
  --arg pausedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --argjson currentReplicas "$CURRENT_REPLICAS" \
  '{
    metadata: {
      annotations: {
        "nullplatform.com/autoscaling-paused": (
          {
            originalMinReplicas: ($originalMin | tonumber),
            originalMaxReplicas: ($originalMax | tonumber),
            pausedAt: $pausedAt
          } | tostring
        )
      }
    },
    spec: {
      minReplicas: $currentReplicas,
      maxReplicas: $currentReplicas
    }
  }')

kubectl patch hpa "$HPA_NAME" -n "$K8S_NAMESPACE" --type='merge' -p "$PATCH"

log info ""
log info "✅ Autoscaling paused successfully"
log debug "   HPA: $HPA_NAME"
log debug "   Namespace: $K8S_NAMESPACE"
log debug "   Fixed replicas: $CURRENT_REPLICAS"
log info ""
log debug "📋 To resume autoscaling, use the resume-autoscaling action or manually patch the HPA."
