#!/bin/bash

set -euo pipefail


IAM=${IAM-"{}"}

IAM_ENABLED=$(echo "$IAM" | jq -r .ENABLED)

if [[ "$IAM_ENABLED" == "false" || "$IAM_ENABLED" == "null" ]]; then
  log debug "📋 IAM is not enabled, skipping role deletion"
  return
fi

log debug "🔍 Looking for IAM role: $SERVICE_ACCOUNT_NAME"
ROLE_ARN=$(aws iam get-role --role-name "$SERVICE_ACCOUNT_NAME" --query 'Role.Arn' --output text 2>&1) || {
  if [[ "$ROLE_ARN" == *"NoSuchEntity"* ]] && [[ "$ROLE_ARN" == *"cannot be found"* ]]; then
    log debug "📋 IAM role '$SERVICE_ACCOUNT_NAME' does not exist, skipping role deletion"
    return 0
  fi

  log error "   ❌ Failed to find IAM role '$SERVICE_ACCOUNT_NAME'${ROLE_ARN:+: $ROLE_ARN}"
  log error ""
  log error "💡 Possible causes:"
  log error "   The IAM role may not exist or the agent lacks IAM permissions"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Verify the role exists: aws iam get-role --role-name $SERVICE_ACCOUNT_NAME"
  log error "   • Check IAM permissions for the agent role"
  log error ""
  exit 1
}

ROLE_NAME="$SERVICE_ACCOUNT_NAME"

pod_identity_association_error() {
  log error "   ❌ $1"
  log error ""
  log error "💡 Possible causes:"
  log error "   The agent lacks eks:ListPodIdentityAssociations or eks:DeletePodIdentityAssociation"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Check the associations: aws eks list-pod-identity-associations --cluster-name $CLUSTER_NAME --namespace $NAMESPACE"
  log error ""
  exit 1
}

TRUSTED_SERVICES=$(aws iam get-role --role-name "$ROLE_NAME" \
  --query 'Role.AssumeRolePolicyDocument.Statement[].Principal.Service' --output text 2>&1) || {
  log error "   ❌ Failed to read the trust policy of IAM role '$ROLE_NAME'${TRUSTED_SERVICES:+: $TRUSTED_SERVICES}"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Check IAM permissions for the agent role"
  log error ""
  exit 1
}

if [[ "$TRUSTED_SERVICES" == *"pods.eks.amazonaws.com"* ]]; then
  NAMESPACE=$(echo "$CONTEXT" | jq -r .k8s_namespace)
  log debug "📝 Deleting pod identity associations of service account: $NAMESPACE/$ROLE_NAME"
  ASSOCIATION_IDS=$(aws eks list-pod-identity-associations \
    --cluster-name "$CLUSTER_NAME" \
    --namespace "$NAMESPACE" \
    --service-account "$ROLE_NAME" \
    --query 'associations[].associationId' --output text 2>&1) \
    || pod_identity_association_error "Failed to list pod identity associations of '$NAMESPACE/$ROLE_NAME'${ASSOCIATION_IDS:+: $ASSOCIATION_IDS}"

  for association_id in $ASSOCIATION_IDS; do
    if [[ "$association_id" == "None" ]]; then
      continue
    fi
    DELETE_ASSOCIATION_OUT=$(aws eks delete-pod-identity-association \
      --cluster-name "$CLUSTER_NAME" \
      --association-id "$association_id" 2>&1) \
      || pod_identity_association_error "Failed to delete pod identity association '$association_id'${DELETE_ASSOCIATION_OUT:+: $DELETE_ASSOCIATION_OUT}"
    log info "   ✅ Deleted pod identity association: $association_id"
  done
fi

log debug "📝 Detaching managed policies..."
aws iam list-attached-role-policies --role-name "$ROLE_NAME" --query 'AttachedPolicies[].PolicyArn' --output text | \
tr '\t' '\n' | while read policy_arn; do
  if [ -n "$policy_arn" ]; then
    log debug "📋 Detaching policy: $policy_arn"
    aws iam detach-role-policy --role-name "$ROLE_NAME" --policy-arn "$policy_arn"
    log info "   ✅ Detached policy: $policy_arn"
  fi
done

log debug "📝 Deleting inline policies..."
aws iam list-role-policies --role-name "$ROLE_NAME" --query 'PolicyNames' --output text | \
tr '\t' '\n' | while read policy_name; do
  if [ -n "$policy_name" ]; then
    log debug "📋 Deleting inline policy: $policy_name"
    aws iam delete-role-policy --role-name "$ROLE_NAME" --policy-name "$policy_name"
    log info "   ✅ Deleted inline policy: $policy_name"
  fi
done

log debug "📝 Deleting IAM role: $ROLE_NAME"
aws iam delete-role --role-name "$ROLE_NAME" 2>&1 || {
  log warn "   ⚠️  Failed to delete IAM role '$ROLE_NAME'"
  log warn ""
  log warn "💡 Possible causes:"
  log warn "   The role may still have attached policies, instance profiles, or was already deleted"
  log warn ""
  log warn "🔧 How to fix:"
  log warn "   • Check attached policies: aws iam list-attached-role-policies --role-name $ROLE_NAME"
  log warn "   • Check instance profiles: aws iam list-instance-profiles-for-role --role-name $ROLE_NAME"
  log warn ""
}
log info "   ✅ IAM role deletion completed"
