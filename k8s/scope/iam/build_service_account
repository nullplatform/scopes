#!/bin/bash

set -euo pipefail


IAM=${IAM-"{}"}

IAM_ENABLED=$(echo "$IAM" | jq -r .ENABLED)
SCOPE_CONTEXT=${CONTEXT:-"{}"}
SCOPE_SA_ENABLED=$(echo "$SCOPE_CONTEXT" | jq -r '.service_account.enabled // false')
SCOPE_SA_NAME=$(echo "$SCOPE_CONTEXT" | jq -r '.service_account.name // ""')

# render_service_account <name> <role_arn>: an empty role_arn renders no IAM annotation.
render_service_account() {
  local service_account_name="$1" role_arn="$2"
  local context_path="$OUTPUT_DIR/context-$SCOPE_ID.json"
  local service_account_path="$OUTPUT_DIR/service_account-$SCOPE_ID.yaml"

  echo "$CONTEXT" | jq --arg role_arn "$role_arn" --arg service_account_name "$service_account_name" '. + {role_arn: $role_arn, service_account_name: $service_account_name}' > "$context_path"

  log debug "📝 Building service account template: $SERVICE_ACCOUNT_TEMPLATE"
  local gomplate_out
  gomplate_out=$(gomplate -c .="$context_path" \
    --file "$SERVICE_ACCOUNT_TEMPLATE" \
    --out "$service_account_path" 2>&1) || {
    log error "   ❌ Failed to build service account template${gomplate_out:+: $gomplate_out}"
    log error ""
    log error "💡 Possible causes:"
    log error "   The template file may be missing or contain invalid gomplate syntax"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Verify template exists: ls -la $SERVICE_ACCOUNT_TEMPLATE"
    log error "   • Check the template is a valid Kubernetes ServiceAccount YAML with correct gomplate expressions"
    log error ""
    exit 1
  }

  rm "$context_path"
  log info "   ✅ Service account template built successfully"
}

if [[ "$IAM_ENABLED" == "false" || "$IAM_ENABLED" == "null" ]]; then
  if [[ "$SCOPE_SA_ENABLED" != "true" ]]; then
    log debug "📋 IAM is not enabled, skipping service account setup"
    return
  fi

  if [[ -z "$SCOPE_SA_NAME" ]]; then
    log error "   ❌ Service account is enabled but its name is empty"
    log error ""
    log error "💡 Possible causes:"
    log error "   The scope context was built without a resolved service account name"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Set security.service_account_name in the scope-configurations provider"
    log error ""
    exit 1
  fi

  log debug "📋 Using the per-scope service account: $SCOPE_SA_NAME"
  render_service_account "$SCOPE_SA_NAME" ""
  return
fi

# Deployments ensure only the per-scope service account; the IAM one is owned by the scope workflows.
if [[ "${IAM_SERVICE_ACCOUNT:-}" == "skip" ]]; then
  log debug "📋 IAM service account is managed by the scope workflows, skipping"
  return
fi

SERVICE_ACCOUNT_NAME=$(echo "$IAM" | jq -r .PREFIX)-"$SCOPE_ID"
log debug "🔍 Looking for IAM role: $SERVICE_ACCOUNT_NAME"

ROLE_ARN=$(aws iam get-role --role-name "$SERVICE_ACCOUNT_NAME" --query 'Role.Arn' --output text 2>&1) || {
  if [[ "${ACTION:-}" == "delete" ]] && [[ "$ROLE_ARN" == *"NoSuchEntity"* ]] && [[ "$ROLE_ARN" == *"cannot be found"* ]]; then
    log debug "📋 IAM role '$SERVICE_ACCOUNT_NAME' does not exist, skipping service account deletion"
    return 0
  fi

  log error "   ❌ Failed to find IAM role '$SERVICE_ACCOUNT_NAME'${ROLE_ARN:+: $ROLE_ARN}"
  log error ""
  log error "💡 Possible causes:"
  log error "   The IAM role may not exist or the agent lacks IAM permissions"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Verify the role exists: aws iam get-role --role-name $SERVICE_ACCOUNT_NAME"
  log error "   • Check IAM permissions for the agent role"
  log error ""
  exit 1
}

render_service_account "$SERVICE_ACCOUNT_NAME" "$ROLE_ARN"
