#!/bin/bash

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/../../utils/resolve_iam_role_name"

IAM=${IAM-"{}"}

IAM_ENABLED=$(echo "$IAM" | jq -r .ENABLED)

if [[ "$IAM_ENABLED" == "false" || "$IAM_ENABLED" == "null" ]]; then
  log debug "📋 IAM is not enabled, skipping service account setup"
  return
fi

IAM_MODE=$(echo "$IAM" | jq -r 'if has("MODE") then .MODE else "irsa" end')

IAM_DIMENSION=$(echo "$IAM" | jq -r '.DIMENSION // "environment"')

# The application ids of the scopes, other than this one, that are not deleted
# or being deleted and share the application and the IAM.DIMENSION value. Any
# scope type counts: a scope that does not use the service account only keeps it.
_gke_other_scopes_of_service_account() {
  local scopes
  scopes=$(np scope list --application-id "$APPLICATION_ID" --all --limit 200 --format json 2>&1) || {
    echo "$scopes"
    return 1
  }
  echo "$scopes" | jq -r --arg id "$(echo "$CONTEXT" | jq -r .scope.id)" --arg d "$IAM_DIMENSION" --arg env "$IAM_GKE_ENVIRONMENT" '
    (if type == "array" then . elif type == "object" and (.results | type) == "array" then .results else error("unexpected np scope list output") end)
    | [.[] | select((.id | tostring) != $id
        and (.status | IN("deleted", "deleting") | not)
        and ((.dimensions[$d] // "" | tostring | ascii_downcase) == $env))
      | .id | tostring] | join(",")' 2>&1
}

if [[ "$IAM_MODE" == "gke" && "${ACTION:-}" == "delete" ]]; then
  if ! resolve_iam_role_name "" "$SCOPE_ID" "" "$IAM_MODE" "$IAM_DIMENSION" >/dev/null 2>&1; then
    log warn "⚠️  IAM mode is gke and the scope's '$IAM_DIMENSION' dimension cannot name a service account: nothing to delete"
    return 0
  fi
  SERVICE_ACCOUNT_NAME="$IAM_ROLE_NAME"
  APPLICATION_ID=$(echo "$CONTEXT" | jq -r .application.id)

  if ! OTHER_SCOPES=$(_gke_other_scopes_of_service_account); then
    log warn "⚠️  Keeping service account '$SERVICE_ACCOUNT_NAME': could not tell whether other scopes of application $APPLICATION_ID in '$IAM_GKE_ENVIRONMENT' use it${OTHER_SCOPES:+: $OTHER_SCOPES}"
    log warn "🔧 How to fix:"
    log warn "   • Check that the agent can run: np scope list --application-id $APPLICATION_ID"
    log warn "   • Delete it by hand once no scope of the application in '$IAM_GKE_ENVIRONMENT' is left"
    return 0
  fi
  if [[ -n "$OTHER_SCOPES" ]]; then
    log debug "📋 Keeping service account '$SERVICE_ACCOUNT_NAME': scopes $OTHER_SCOPES of application $APPLICATION_ID in '$IAM_GKE_ENVIRONMENT' still use it"
    return 0
  fi
  log debug "📋 No other scope of application $APPLICATION_ID in '$IAM_GKE_ENVIRONMENT' is left, deleting service account '$SERVICE_ACCOUNT_NAME'"
else
  resolve_iam_role_name "$(echo "$IAM" | jq -r .PREFIX)" "$SCOPE_ID" "$(echo "$CONTEXT" | jq -r .k8s_namespace)" "$IAM_MODE" \
    "$IAM_DIMENSION" || exit 1
  SERVICE_ACCOUNT_NAME="$IAM_ROLE_NAME"
fi

if [[ "$IAM_MODE" == "gke" ]]; then
  log debug "📋 IAM mode is gke, building service account '$SERVICE_ACCOUNT_NAME' without an IAM role"
  ROLE_ARN=""
  SERVICE_ACCOUNT_NAMESPACE=$(echo "$CONTEXT" | jq -r .k8s_namespace)
  APPLICATION_ID=$(echo "$CONTEXT" | jq -r .application.id)

  # Reuse (or delete) a service account with this name only if it was created
  # for the same application and environment.
  EXISTING_SERVICE_ACCOUNT=$(kubectl get serviceaccount "$SERVICE_ACCOUNT_NAME" -n "$SERVICE_ACCOUNT_NAMESPACE" \
    --ignore-not-found -o json 2>&1) || {
    if [[ "${ACTION:-}" == "delete" ]]; then
      log warn "⚠️  Keeping service account '$SERVICE_ACCOUNT_NAMESPACE/$SERVICE_ACCOUNT_NAME': could not look it up${EXISTING_SERVICE_ACCOUNT:+: $EXISTING_SERVICE_ACCOUNT}"
      return 0
    fi
    log error "   ❌ Failed to look up service account '$SERVICE_ACCOUNT_NAMESPACE/$SERVICE_ACCOUNT_NAME'${EXISTING_SERVICE_ACCOUNT:+: $EXISTING_SERVICE_ACCOUNT}"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Check that the agent can get serviceaccounts in '$SERVICE_ACCOUNT_NAMESPACE'"
    log error ""
    exit 1
  }
  if [[ -z "$EXISTING_SERVICE_ACCOUNT" && "${ACTION:-}" == "delete" ]]; then
    log debug "📋 Service account '$SERVICE_ACCOUNT_NAME' does not exist, skipping service account deletion"
    return 0
  fi
  if [[ -n "$EXISTING_SERVICE_ACCOUNT" ]]; then
    EXISTING_LABELS=$(echo "$EXISTING_SERVICE_ACCOUNT" | jq -r '[.metadata.labels.application_id // "", .metadata.labels.environment // ""] | join(" ")')
    if [[ "$EXISTING_LABELS" != "$APPLICATION_ID $IAM_GKE_ENVIRONMENT" ]]; then
      if [[ "${ACTION:-}" == "delete" ]]; then
        log warn "⚠️  Keeping service account '$SERVICE_ACCOUNT_NAMESPACE/$SERVICE_ACCOUNT_NAME': its application_id/environment labels '$EXISTING_LABELS' are not '$APPLICATION_ID $IAM_GKE_ENVIRONMENT'"
        return 0
      fi
      log error "   ❌ Service account '$SERVICE_ACCOUNT_NAMESPACE/$SERVICE_ACCOUNT_NAME' already exists with application_id/environment labels '$EXISTING_LABELS', not '$APPLICATION_ID $IAM_GKE_ENVIRONMENT'"
      log error ""
      log error "💡 Possible causes:"
      log error "   The service account was created outside nullplatform, or for another application or environment"
      log error ""
      log error "🔧 How to fix:"
      log error "   • Check who owns it: kubectl get serviceaccount $SERVICE_ACCOUNT_NAME -n $SERVICE_ACCOUNT_NAMESPACE -o yaml"
      log error "   • Delete or relabel it only if it is not in use, then retry"
      log error ""
      exit 1
    fi
    log debug "📋 Service account '$SERVICE_ACCOUNT_NAME' belongs to application $APPLICATION_ID in environment '$IAM_GKE_ENVIRONMENT'"
  fi
else
  log debug "🔍 Looking for IAM role: $SERVICE_ACCOUNT_NAME"

  ROLE_ARN=$(aws iam get-role --role-name "$SERVICE_ACCOUNT_NAME" --query 'Role.Arn' --output text 2>&1) || {
    if [[ "${ACTION:-}" == "delete" ]] && [[ "$ROLE_ARN" == *"NoSuchEntity"* ]] && [[ "$ROLE_ARN" == *"cannot be found"* ]]; then
      log debug "📋 IAM role '$SERVICE_ACCOUNT_NAME' does not exist, skipping service account deletion"
      return 0
    fi

    log error "   ❌ Failed to find IAM role '$SERVICE_ACCOUNT_NAME'${ROLE_ARN:+: $ROLE_ARN}"
    log error ""
    log error "💡 Possible causes:"
    log error "   The IAM role may not exist or the agent lacks IAM permissions"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Verify the role exists: aws iam get-role --role-name $SERVICE_ACCOUNT_NAME"
    log error "   • Check IAM permissions for the agent role"
    log error ""
    exit 1
  }
fi

CONTEXT_PATH="$OUTPUT_DIR/context-$SCOPE_ID.json"
SERVICE_ACCOUNT_PATH="$OUTPUT_DIR/service_account-$SCOPE_ID.yaml"

echo "$CONTEXT" | jq --arg role_arn "$ROLE_ARN" --arg service_account_name "$SERVICE_ACCOUNT_NAME" --arg iam_mode "$IAM_MODE" \
  --arg gke_environment "${IAM_GKE_ENVIRONMENT:-}" \
  '. + {role_arn: $role_arn, service_account_name: $service_account_name, iam_mode: $iam_mode, gke_environment: $gke_environment}' > "$CONTEXT_PATH"

log debug "📝 Building service account template: $SERVICE_ACCOUNT_TEMPLATE"
GOMPLATE_OUT=$(gomplate -c .="$CONTEXT_PATH" \
  --file "$SERVICE_ACCOUNT_TEMPLATE" \
  --out "$SERVICE_ACCOUNT_PATH" 2>&1) || {
  log error "   ❌ Failed to build service account template${GOMPLATE_OUT:+: $GOMPLATE_OUT}"
  log error ""
  log error "💡 Possible causes:"
  log error "   The template file may be missing or contain invalid gomplate syntax"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Verify template exists: ls -la $SERVICE_ACCOUNT_TEMPLATE"
  log error "   • Check the template is a valid Kubernetes ServiceAccount YAML with correct gomplate expressions"
  log error ""
  exit 1
}

rm "$CONTEXT_PATH"
log info "   ✅ Service account template built successfully"
