#!/bin/bash

set -euo pipefail


IAM=${IAM-"{}"}

IAM_ENABLED=$(echo "$IAM" | jq -r .ENABLED)

if [[ "$IAM_ENABLED" == "false" || "$IAM_ENABLED" == "null" ]]; then
  log debug "📋 IAM is not enabled, skipping role creation"
  return
fi

IAM_MODE=$(echo "$IAM" | jq -r 'if has("MODE") then .MODE else "irsa" end')
if [[ "$IAM_MODE" != "irsa" && "$IAM_MODE" != "pod_identity" ]]; then
  log error "   ❌ Invalid IAM mode '$IAM_MODE'"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Set IAM.MODE to irsa or pod_identity, or remove it to use irsa"
  log error ""
  exit 1
fi

if ! type -t resolve_iam_role_name >/dev/null 2>&1; then
  source "$(dirname "${BASH_SOURCE[0]}")/../../utils/resolve_iam_role_name"
fi

NAMESPACE=$(echo "$CONTEXT" | jq -r .k8s_namespace)
resolve_iam_role_name "$(echo "$IAM" | jq -r .PREFIX)" "$SCOPE_ID" "$NAMESPACE" || exit 1
ROLE_NAME="$IAM_ROLE_NAME"
ROLE_PATH="/nullplatform/custom-scopes/"

if [[ "$IAM_MODE" == "irsa" ]]; then
  log debug "🔍 Getting EKS OIDC provider for cluster: $CLUSTER_NAME"
  OIDC_PROVIDER=$(aws eks describe-cluster --name "$CLUSTER_NAME" --query "cluster.identity.oidc.issuer" --output text 2>&1 | sed -e "s/^https:\/\///") || {
    log error "   ❌ Failed to get OIDC provider for EKS cluster '$CLUSTER_NAME'${OIDC_PROVIDER:+: $OIDC_PROVIDER}"
    log error ""
    log error "💡 Possible causes:"
    log error "   The OIDC provider may not be configured for this EKS cluster"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Verify OIDC is enabled: aws eks describe-cluster --name $CLUSTER_NAME --query cluster.identity.oidc"
    log error "   • Enable OIDC provider: eksctl utils associate-iam-oidc-provider --cluster $CLUSTER_NAME --approve"
    log error ""
    exit 1
  }
else
  log debug "🔍 Getting EKS cluster ARN for cluster: $CLUSTER_NAME"
  CLUSTER_ARN=$(aws eks describe-cluster --name "$CLUSTER_NAME" --query "cluster.arn" --output text 2>&1) || {
    log error "   ❌ Failed to get the ARN of EKS cluster '$CLUSTER_NAME'${CLUSTER_ARN:+: $CLUSTER_ARN}"
    log error ""
    log error "💡 Possible causes:"
    log error "   The cluster name may be wrong or the agent lacks eks:DescribeCluster"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Verify the cluster exists: aws eks describe-cluster --name $CLUSTER_NAME"
    log error ""
    exit 1
  }
fi

log debug "🔍 Getting AWS account ID..."
AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text 2>&1) || {
  log error "   ❌ Failed to get AWS account ID${AWS_ACCOUNT_ID:+: $AWS_ACCOUNT_ID}"
  log error ""
  log error "💡 Possible causes:"
  log error "   AWS credentials may not be configured or have expired"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Check AWS credentials: aws sts get-caller-identity"
  log error "   • Verify IAM permissions for the agent role"
  log error ""
  exit 1
}
TRUST_POLICY_PATH="$OUTPUT_DIR/trust-policy.json"

if [[ "$IAM_MODE" == "irsa" ]]; then
cat > "$TRUST_POLICY_PATH" <<EOF
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::${AWS_ACCOUNT_ID}:oidc-provider/${OIDC_PROVIDER}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "${OIDC_PROVIDER}:sub": "system:serviceaccount:${NAMESPACE}:${ROLE_NAME}"
        }
      }
    }
  ]
}
EOF
else
  jq -n --arg account "$AWS_ACCOUNT_ID" --arg cluster "$CLUSTER_ARN" '{
    Version: "2012-10-17",
    Statement: [{
      Effect: "Allow",
      Principal: {Service: "pods.eks.amazonaws.com"},
      Action: ["sts:AssumeRole", "sts:TagSession"],
      Condition: {
        StringEquals: {"aws:SourceAccount": $account},
        ArnEquals: {"aws:SourceArn": $cluster}
      }
    }]
  }' > "$TRUST_POLICY_PATH"
fi

BOUNDARY_ARN=$(echo "$IAM" | jq -r .ROLE.BOUNDARY_ARN)

APPLICATION_ID=$(echo "$CONTEXT" | jq -r '.application.id')
APPLICATION_SLUG=$(echo "$CONTEXT" | jq -r '.application.slug')
SCOPE_ID=$(echo "$CONTEXT" | jq -r '.scope.id')
SCOPE_SLUG=$(echo "$CONTEXT" | jq -r '.scope.slug')
ACCOUNT_ID=$(echo "$CONTEXT" | jq -r '.account.id')
ACCOUNT_SLUG=$(echo "$CONTEXT" | jq -r '.account.slug')
ORGANIZATION_ID=$(echo "$CONTEXT" | jq -r '.account.organization_id')
NAMESPACE_ID=$(echo "$CONTEXT" | jq -r '.namespace.id')
NAMESPACE_SLUG=$(echo "$CONTEXT" | jq -r '.namespace.slug')
DIMENSIONS=$(echo "$CONTEXT" | jq '.scope.dimensions')

BASE_TAGS=(
  "Key=application_id,Value=$APPLICATION_ID"
  "Key=application,Value=$APPLICATION_SLUG"
  "Key=scope_id,Value=$SCOPE_ID"
  "Key=scope,Value=$SCOPE_SLUG"
  "Key=account_id,Value=$ACCOUNT_ID"
  "Key=account,Value=$ACCOUNT_SLUG"
  "Key=organization_id,Value=$ORGANIZATION_ID"
  "Key=namespace_id,Value=$NAMESPACE_ID"
  "Key=namespace,Value=$NAMESPACE_SLUG"
  "Key=nullplatform,Value=true"
)

if [[ -n "$DIMENSIONS" && "$DIMENSIONS" != "null" ]]; then
  while IFS= read -r key; do
    value=$(echo "$DIMENSIONS" | jq -r --arg k "$key" '.[$k]')
    if [[ "$value" != "null" && -n "$value" ]]; then
      BASE_TAGS+=("Key=$key,Value=$value")
    fi
  done < <(echo "$DIMENSIONS" | jq -r 'keys[]')
fi

IAM_TAG_CHARSET='^[A-Za-z0-9 _.:/=+@-]*$'

while IFS=$'\t' read -r key template; do
  value="$template"
  if [[ "$template" == *"{"* ]]; then
    value=$(np_name_render 256 "$template") || {
      log error "   ❌ Could not render tag '$key' from pattern '$template'"
      log error ""
      log error "🔧 How to fix:"
      log error "   • Fix IAM.TAGS; see k8s/docs/resource-naming.md"
      log error ""
      exit 1
    }
  fi

  key_lower=$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')
  if [[ -z "$key" || ${#key} -gt 128 || ${#value} -gt 256 || "$key_lower" == aws:* ]] || ! [[ "$key$value" =~ $IAM_TAG_CHARSET ]]; then
    log error "   ❌ Tag '$key' in IAM.TAGS has an invalid key or value '$value'"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Use letters, digits, spaces and _ . : / = + - @ (keys up to 128 characters, values up to 256), and do not start a key with aws:"
    log error ""
    exit 1
  fi

  for tag in "${BASE_TAGS[@]}"; do
    tag_lower=$(printf '%s' "$tag" | tr '[:upper:]' '[:lower:]')
    if [[ "$tag_lower" == "key=$key_lower,value="* ]]; then
      log error "   ❌ Tag '$key' in IAM.TAGS is already set by nullplatform"
      log error ""
      log error "🔧 How to fix:"
      log error "   • Rename or remove '$key' from IAM.TAGS"
      log error ""
      exit 1
    fi
  done

  log debug "📋 Adding tag: $key=$value"
  BASE_TAGS+=("Key=$key,Value=$value")
done < <(echo "$IAM" | jq -r '(.TAGS // {}) | to_entries[] | [.key, (.value | tostring)] | @tsv')

create_role_error() {
  log error "   ❌ Failed to create IAM role '$ROLE_NAME'${CREATE_ROLE_OUT:+: $CREATE_ROLE_OUT}"
  log error ""
  log error "💡 Possible causes:"
  log error "   The role may already exist or the agent lacks IAM permissions"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Check if role exists: aws iam get-role --role-name $ROLE_NAME"
  log error "   • Verify IAM permissions for the agent role"
  log error ""
  exit 1
}

log debug "📝 Creating IAM role: $ROLE_NAME"

CREATE_ROLE_ARGS=(
  --role-name "$ROLE_NAME"
  --path "$ROLE_PATH"
  --assume-role-policy-document "file://$TRUST_POLICY_PATH"
  --tags "${BASE_TAGS[@]}"
  --no-paginate
)

if [[ -n "$BOUNDARY_ARN" && "$BOUNDARY_ARN" != "null" ]]; then
  log debug "📋 Using permissions boundary: $BOUNDARY_ARN"
  CREATE_ROLE_ARGS+=(--permissions-boundary "$BOUNDARY_ARN")
fi

CREATE_ROLE_OUT=$(aws iam create-role "${CREATE_ROLE_ARGS[@]}" 2>&1) || create_role_error
[[ -n "$CREATE_ROLE_OUT" ]] && echo "$CREATE_ROLE_OUT"
log info "   ✅ IAM role created successfully"

rm "$TRUST_POLICY_PATH"

POLICIES_COUNT=$(echo "$IAM" | jq '.ROLE.POLICIES | length // 0')
for ((i=0; i<$POLICIES_COUNT; i++)); do
  POLICY_TYPE=$(echo "$IAM" | jq -r ".ROLE.POLICIES[$i].TYPE")
  POLICY_VALUE=$(echo "$IAM" | jq -r ".ROLE.POLICIES[$i].VALUE")

  log debug "📋 Processing policy $((i+1)): Type=$POLICY_TYPE"

  if [[ "$POLICY_TYPE" == "arn" ]]; then
    log debug "📝 Attaching managed policy: $POLICY_VALUE"
    ATTACH_POLICY_OUT=$(aws iam attach-role-policy \
      --role-name "$ROLE_NAME" \
      --policy-arn "$POLICY_VALUE" 2>&1) || {
      log error "   ❌ Failed to attach managed policy: $POLICY_VALUE${ATTACH_POLICY_OUT:+ — $ATTACH_POLICY_OUT}"
      log error ""
      log error "💡 Possible causes:"
      log error "   The policy ARN may be invalid or the agent lacks IAM permissions"
      log error ""
      log error "🔧 How to fix:"
      log error "   • Verify policy exists: aws iam get-policy --policy-arn $POLICY_VALUE"
      log error "   • Check IAM permissions for the agent role"
      log error ""
      exit 1
    }
    [[ -n "$ATTACH_POLICY_OUT" ]] && echo "$ATTACH_POLICY_OUT"
    log info "   ✅ Successfully attached managed policy: $POLICY_VALUE"

  elif [[ "$POLICY_TYPE" == "inline" ]]; then
    POLICY_NAME="inline-policy-$((i+1))"
    log debug "📝 Attaching inline policy: $POLICY_NAME"

    TEMP_POLICY_FILE="$OUTPUT_DIR/inline-policy-$i.json"
    echo "$POLICY_VALUE" > "$TEMP_POLICY_FILE"

    PUT_POLICY_OUT=$(aws iam put-role-policy \
      --role-name "$ROLE_NAME" \
      --policy-name "$POLICY_NAME" \
      --policy-document "file://$TEMP_POLICY_FILE" 2>&1) || {
      log error "   ❌ Failed to attach inline policy: $POLICY_NAME${PUT_POLICY_OUT:+ — $PUT_POLICY_OUT}"
      log error ""
      log error "💡 Possible causes:"
      log error "   The inline policy JSON may be invalid or the agent lacks IAM permissions"
      log error ""
      log error "🔧 How to fix:"
      log error "   • Validate the policy JSON syntax"
      log error "   • Check IAM permissions for the agent role"
      log error ""
      rm -f "$TEMP_POLICY_FILE"
      exit 1
    }
    [[ -n "$PUT_POLICY_OUT" ]] && echo "$PUT_POLICY_OUT"
    log info "   ✅ Successfully attached inline policy: $POLICY_NAME"

    rm -f "$TEMP_POLICY_FILE"

  else
    log warn "⚠️  Unknown policy type: $POLICY_TYPE, skipping"
  fi
done

if [[ "$IAM_MODE" == "pod_identity" ]]; then
  ROLE_ARN=$(echo "$CREATE_ROLE_OUT" | jq -r '.Role.Arn')
  ASSOCIATION_TAGS=$(printf '%s\n' "${BASE_TAGS[@]}" | jq -cRn '[inputs | capture("^Key=(?<key>[^,]*),Value=(?<value>.*)$")] | from_entries')

  log debug "📝 Creating pod identity association for service account: $NAMESPACE/$ROLE_NAME"
  ASSOCIATION_OUT=$(aws eks create-pod-identity-association \
    --cluster-name "$CLUSTER_NAME" \
    --namespace "$NAMESPACE" \
    --service-account "$ROLE_NAME" \
    --role-arn "$ROLE_ARN" \
    --tags "$ASSOCIATION_TAGS" 2>&1) || {
    log error "   ❌ Failed to create pod identity association for '$NAMESPACE/$ROLE_NAME'${ASSOCIATION_OUT:+: $ASSOCIATION_OUT}"
    log error ""
    log error "💡 Possible causes:"
    log error "   The association may already exist or the agent lacks eks:CreatePodIdentityAssociation or iam:PassRole"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Check existing associations: aws eks list-pod-identity-associations --cluster-name $CLUSTER_NAME --namespace $NAMESPACE"
    log error "   • Verify the agent role can pass roles under $ROLE_PATH"
    log error ""
    exit 1
  }
  if [[ -n "$ASSOCIATION_OUT" ]]; then
    echo "$ASSOCIATION_OUT"
  fi
  log info "   ✅ Pod identity association created successfully"
fi
