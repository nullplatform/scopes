#!/bin/bash
# Runs a read-only kubectl query for a scope and stores its output in the
# action's results.
#
# The agent's identity can usually do anything in the cluster, so what keeps
# this action read-only is decided here, by allowlist:
#   - the verb: "get" or "logs", run through kubectl_get / kubectl_logs, which
#     hardcode it and strip secret values
#   - the resource: for "get", only the types listed below, one per query.
#     Secrets are not in the list, so they cannot be listed at all
#   - the flags: only the ones listed below. Anything else that starts with "-"
#     is refused, so a flag that changes the server (-s), reads a local file
#     (-f, -o go-template-file=) or writes one (--profile-output) never reaches
#     kubectl
#   - the namespace: the scope's own, plus the ones in
#     K8S_READ_ALLOWED_NAMESPACES (comma separated; "*" allows any, and -A).
#     The scope's routes attach to gateways that live in another namespace, so
#     the ones in K8S_READ_NETWORK_NAMESPACES (default "gateways") accept
#     "logs", and "get" of the types listed in NETWORK_RESOURCES: the routing
#     objects and the workloads behind them, and nothing else. A gateway serves
#     every application, so from its logs only the requests to this scope's
#     domains come back, plus the lines that are not requests
#
# Parameters (action): command ("get" | "logs"), args (array of strings),
# filter (logs only: keep the lines that contain this text, any case).

set -uo pipefail

SERVICE_PATH="${SERVICE_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

PARAMETERS=$(echo "$NP_ACTION_CONTEXT" | jq -c '.notification.parameters // {}')
COMMAND=$(echo "$PARAMETERS" | jq -r '.command // empty')

case "$COMMAND" in
  get)  WRAPPER="$SERVICE_PATH/kubectl_get" ;;
  logs) WRAPPER="$SERVICE_PATH/kubectl_logs" ;;
  *)
    log error "❌ Unsupported command '$COMMAND'"
    log error ""
    log error "🔧 How to fix:"
    log error "   • Set the 'command' parameter to 'get' or 'logs'"
    exit 1
    ;;
esac

if ! echo "$PARAMETERS" | jq -e '(.args // []) | type == "array" and all(.[]; type == "string")' >/dev/null; then
  log error "❌ The 'args' parameter must be an array of strings"
  exit 1
fi

if ! echo "$PARAMETERS" | jq -e '(.filter // "") | type == "string" and length <= 200' >/dev/null; then
  log error "❌ The 'filter' parameter must be a text of up to 200 characters"
  exit 1
fi
FILTER=$(echo "$PARAMETERS" | jq -r '.filter // empty')

# One argument per array item, NUL-separated so spaces and newlines survive.
ARGS=()
while IFS= read -r -d '' ARG; do
  ARGS+=("$ARG")
done < <(echo "$PARAMETERS" | jq -j '(.args // [])[] | . + "\u0000"')

# Flags that take a value, as "-x value", "--flag value" or "--flag=value".
GET_VALUE_FLAGS=(-n --namespace -l --selector -o --output --sort-by --field-selector -L --label-columns)
GET_SWITCH_FLAGS=(-A --all-namespaces --show-labels --no-headers --show-kind --ignore-not-found)
LOGS_VALUE_FLAGS=(-n --namespace -l --selector -c --container --tail --since --since-time --max-log-requests --limit-bytes)
LOGS_SWITCH_FLAGS=(--all-containers -p --previous --timestamps --prefix)

# Resource types "get" may query. Keep in sync with the pattern of the first
# item of args in specs/actions/k8s-read.json.tpl.
GET_RESOURCES=(
  pods pod po deployments deployment deploy replicasets replicaset rs statefulsets statefulset sts
  daemonsets daemonset ds jobs job cronjobs cronjob cj replicationcontrollers
  replicationcontroller rc services service svc endpoints ep endpointslices endpointslice
  ingresses ingress ing ingressclasses ingressclass networkpolicies networkpolicy netpol events
  event ev configmaps configmap cm horizontalpodautoscalers horizontalpodautoscaler hpa
  verticalpodautoscalers verticalpodautoscaler vpa poddisruptionbudgets poddisruptionbudget pdb
  persistentvolumeclaims persistentvolumeclaim pvc persistentvolumes persistentvolume pv
  storageclasses storageclass sc serviceaccounts serviceaccount sa nodes node no namespaces
  namespace ns resourcequotas resourcequota quota limitranges limitrange limits leases lease
  priorityclasses priorityclass pc httproutes httproute grpcroutes grpcroute gateways gateway gtw
  gatewayclasses gatewayclass gc referencegrants referencegrant gateways.gateway.networking.k8s.io
  gateways.networking.istio.io virtualservices virtualservice vs destinationrules destinationrule
  dr serviceentries serviceentry se authorizationpolicies authorizationpolicy peerauthentications
  peerauthentication requestauthentications requestauthentication sidecars sidecar envoyfilters
  envoyfilter targetgroupbindings targetgroupbinding ingressclassparams scaledobjects scaledobject
  so scaledjobs scaledjob sj certificates certificate cert certificaterequests certificaterequest
  cr nodepools nodepool nodeclaims nodeclaim ec2nodeclasses ec2nodeclass
)

# Resource types "get" may query in the K8S_READ_NETWORK_NAMESPACES.
NETWORK_RESOURCES=(
  gateways gateway gtw gateways.gateway.networking.k8s.io gateways.networking.istio.io
  httproutes httproute grpcroutes grpcroute services service svc
  pods pod po deployments deployment deploy replicasets replicaset rs events event ev
  horizontalpodautoscalers horizontalpodautoscaler hpa
)

in_list() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

refuse() {
  log error "❌ $1"
  log error ""
  log error "🔧 How to fix:"
  log error "   • $2"
  exit 1
}

namespace_allowed() {
  local namespace="$1" allowed item
  [[ "$namespace" == "$K8S_NAMESPACE" ]] && return 0
  IFS=',' read -ra allowed <<< "${K8S_READ_ALLOWED_NAMESPACES:-}"
  for item in ${allowed[@]+"${allowed[@]}"}; do
    item="${item//[[:space:]]/}"
    [[ "$item" == "*" || "$item" == "$namespace" ]] && return 0
  done
  return 1
}

network_namespace() {
  local namespace="$1" allowed item
  IFS=',' read -ra allowed <<< "${K8S_READ_NETWORK_NAMESPACES-gateways}"
  for item in ${allowed[@]+"${allowed[@]}"}; do
    item="${item//[[:space:]]/}"
    [[ -n "$item" && "$item" == "$namespace" ]] && return 0
  done
  return 1
}

# The first positional argument is "<type>" or "<type>/<name>". After a bare
# type the rest are names; after "<type>/<name>" each one is that form again.
check_get_resource() {
  local position="$1" arg="$2" type="${2%%/*}"
  if [[ "$position" -gt 0 && "$arg" != */* ]]; then
    return 0
  fi
  in_list "$type" "${GET_RESOURCES[@]}" || refuse \
    "Resource '$type' cannot be read" \
    "Query one of: ${GET_RESOURCES[*]}"
  REQUESTED_TYPES+=("$type")
  if [[ "$arg" == */* && ! "${arg#*/}" =~ ^[a-z0-9][a-z0-9.-]*$ ]]; then
    refuse "Resource name in '$arg' is not valid" "Use <type>/<name>"
  fi
}

check_flag_value() {
  local flag="$1" value="$2"
  case "$flag" in
    -n|--namespace)
      if namespace_allowed "$value"; then
        NETWORK_ONLY_NAMESPACE=""
      elif network_namespace "$value"; then
        NETWORK_ONLY_NAMESPACE="$value"
      else
        refuse "Namespace '$value' is not allowed" \
          "Query the scope's namespace ($K8S_NAMESPACE) or add '$value' to K8S_READ_ALLOWED_NAMESPACES"
      fi
      ;;
    -o|--output)
      # Formats that take a file (go-template-file=, jsonpath-file=, ...) would print a local file.
      case "$value" in
        json|yaml|wide|name|jsonpath=*|jsonpath-as-json=*|custom-columns=*) ;;
        *) refuse "Output format '$value' is not allowed" \
             "Use json, yaml, wide, name, jsonpath=<expr>, jsonpath-as-json=<expr> or custom-columns=<spec>" ;;
      esac
      ;;
  esac
}

validate_args() {
  local -a value_flags switch_flags
  if [[ "$COMMAND" == "get" ]]; then
    value_flags=("${GET_VALUE_FLAGS[@]}"); switch_flags=("${GET_SWITCH_FLAGS[@]}")
  else
    value_flags=("${LOGS_VALUE_FLAGS[@]}"); switch_flags=("${LOGS_SWITCH_FLAGS[@]}")
  fi

  local i=0 positionals=0 arg name value type
  NETWORK_ONLY_NAMESPACE=""
  REQUESTED_TYPES=()
  while (( i < ${#ARGS[@]} )); do
    arg="${ARGS[$i]}"
    i=$((i + 1))
    if [[ "$arg" != -* ]]; then
      [[ "$COMMAND" == "get" ]] && check_get_resource "$positionals" "$arg"
      positionals=$((positionals + 1))
      continue
    fi

    name="$arg"
    [[ "$arg" == --*=* ]] && name="${arg%%=*}"

    if in_list "$name" "${value_flags[@]}"; then
      if [[ "$arg" == --*=* ]]; then
        value="${arg#*=}"
      else
        if (( i >= ${#ARGS[@]} )) || [[ "${ARGS[$i]}" == -* ]]; then
          refuse "Flag '$name' needs a value" "Pass the value as the next item of 'args', or as $name=<value> for a long flag"
        fi
        value="${ARGS[$i]}"
        i=$((i + 1))
      fi
      check_flag_value "$name" "$value"
    elif in_list "$name" "${switch_flags[@]}"; then
      if [[ "$name" == "-A" || "$name" == "--all-namespaces" ]] && ! namespace_allowed "*"; then
        refuse "Flag '$name' is not allowed" "Query one namespace, or set K8S_READ_ALLOWED_NAMESPACES to '*'"
      fi
    else
      refuse "Flag '$arg' is not allowed for '$COMMAND'" \
        "Allowed flags: ${value_flags[*]} ${switch_flags[*]}. Short flags take their value as a separate item"
    fi
  done

  if [[ "$COMMAND" == "get" && "$positionals" -eq 0 ]]; then
    refuse "No resource to read" "Start 'args' with a resource type, e.g. [\"pods\"]"
  fi

  if [[ -n "$NETWORK_ONLY_NAMESPACE" ]]; then
    for type in ${REQUESTED_TYPES[@]+"${REQUESTED_TYPES[@]}"}; do
      in_list "$type" "${NETWORK_RESOURCES[@]}" || refuse \
        "Resource '$type' cannot be read in namespace '$NETWORK_ONLY_NAMESPACE'" \
        "Query one of: ${NETWORK_RESOURCES[*]}, or add '$NETWORK_ONLY_NAMESPACE' to K8S_READ_ALLOWED_NAMESPACES"
    done
  fi
}

K8S_NAMESPACE=$(echo "$CONTEXT" | jq -r --arg default "${K8S_NAMESPACE:-}" '
  .providers["container-orchestration"].cluster.namespace // $default
')

# Find the namespace the scope actually runs in, which may differ from the configured one
source "$SERVICE_PATH/utils/resolve_k8s_namespace"
resolve_k8s_namespace "$K8S_NAMESPACE" || exit 1
export K8S_NAMESPACE

validate_args

if [[ -n "$FILTER" && "$COMMAND" != "logs" ]]; then
  refuse "The 'filter' parameter only applies to logs" "Remove 'filter', or narrow a get with -l or --field-selector"
fi

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT

log debug "🔍 Running kubectl $COMMAND (namespace: $K8S_NAMESPACE)"
# The wrapper loads its own logging and writes to stdout: with tracing or
# debug logging on, its notices would end up inside the output.
NP_TRACE="" LOG_LEVEL=error "$WRAPPER" ${ARGS[@]+"${ARGS[@]}"} > "$WORK_DIR/out" 2> "$WORK_DIR/err"
EXIT_CODE=$?

LINES_READ=$(wc -l < "$WORK_DIR/out" | tr -d ' ')
SCOPE_ONLY=false
if [[ "$COMMAND" == "logs" && -n "$NETWORK_ONLY_NAMESPACE" ]]; then
  # A request line is an access log entry: JSON with "authority", or Envoy's
  # text format. It is found anywhere in the line, because --timestamps and
  # --prefix put text before it. A request comes back only when its authority
  # is one of the scope's domains: the whole field, not a text inside the line,
  # so a path or a header that names the domain does not count.
  K8S_READ_DOMAINS=$(echo "$CONTEXT" | jq -r '[.scope.domain, (.scope.domains // [])[].name] | map(select(. != null and . != "")) | .[]') \
    awk '
      function authority(line,   value) {
        if (!match(line, /"authority": ?"[^"]*"/)) return ""
        value = substr(line, RSTART, RLENGTH)
        sub(/^"authority": ?"/, "", value); sub(/"$/, "", value); sub(/:[0-9]+$/, "", value)
        return tolower(value)
      }
      BEGIN { n = split(tolower(ENVIRON["K8S_READ_DOMAINS"]), domains, "\n") }
      {
        json = index($0, "\"authority\"") > 0
        text = ($0 ~ /\] "[A-Z-]+ [^"]* [A-Z]+\/[0-9.]+"/) || ($0 ~ /\] "- - -"/)
        if (!json && !text) { print; next }
        if (json) {
          host = authority($0)
          for (i = 1; i <= n; i++) if (domains[i] != "" && host == domains[i]) { print; next }
          next
        }
        line = tolower($0)
        for (i = 1; i <= n; i++)
          if (domains[i] != "" && (index(line, "\"" domains[i] "\"") || index(line, "\"" domains[i] ":"))) { print; next }
      }
    ' "$WORK_DIR/out" > "$WORK_DIR/out.scope"
  if [[ $? -ne 0 ]]; then
    : > "$WORK_DIR/out"
    refuse "The gateway logs could not be narrowed to the scope's requests" "Run the query again"
  fi
  mv "$WORK_DIR/out.scope" "$WORK_DIR/out"
  SCOPE_ONLY=true
fi
if [[ -n "$FILTER" ]]; then
  grep -i -F -- "$FILTER" "$WORK_DIR/out" > "$WORK_DIR/out.filter"
  mv "$WORK_DIR/out.filter" "$WORK_DIR/out"
fi
LINES_RETURNED=$(wc -l < "$WORK_DIR/out" | tr -d ' ')

# Keep the end of the output: for logs the last lines are the useful ones.
MAX_BYTES="${K8S_READ_MAX_BYTES:-200000}"
TRUNCATED=false
if [[ $(wc -c < "$WORK_DIR/out") -gt $MAX_BYTES ]]; then
  tail -c "$MAX_BYTES" "$WORK_DIR/out" > "$WORK_DIR/out.cut" && mv "$WORK_DIR/out.cut" "$WORK_DIR/out"
  TRUNCATED=true
  log warn "⚠️  Output truncated to the last $MAX_BYTES bytes"
fi

# The body travels as a file: Linux caps a single argv entry at 128 KiB, and np
# reads --body from disk only when the value ends in .json.
jq -n \
  --rawfile output "$WORK_DIR/out" \
  --rawfile error "$WORK_DIR/err" \
  --argjson exit_code "$EXIT_CODE" \
  --argjson truncated "$TRUNCATED" \
  --arg namespace "$K8S_NAMESPACE" \
  --arg filter "$FILTER" \
  --argjson scope_only "$SCOPE_ONLY" \
  --argjson lines_read "$LINES_READ" \
  --argjson lines_returned "$LINES_RETURNED" \
  '{results: {exit_code: $exit_code, output: $output, error: $error, truncated: $truncated, namespace: $namespace,
              filter: $filter, scope_requests_only: $scope_only, lines_read: $lines_read, lines_returned: $lines_returned}}' \
  > "$WORK_DIR/body.json"

ACTION_ID=$(echo "$NP_ACTION_CONTEXT" | jq -r '.notification.id')
SERVICE_ID=$(echo "$NP_ACTION_CONTEXT" | jq -r '.notification.service.id')

if ! np service action patch --id "$ACTION_ID" --serviceId "$SERVICE_ID" --body "$WORK_DIR/body.json" --no-output; then
  log error "❌ Failed to store the output in the action results"
  exit 1
fi

if [[ $EXIT_CODE -ne 0 ]]; then
  log error "❌ kubectl $COMMAND exited with code $EXIT_CODE"
  log error "$(tail -n 20 "$WORK_DIR/err")"
  exit "$EXIT_CODE"
fi

log info "✅ kubectl $COMMAND completed ($(wc -c < "$WORK_DIR/out" | tr -d ' ') bytes)"
