{
  "account": {"id": 1, "slug": "acme"},
  "namespace": {"id": 11, "slug": "payments"},
  "application": {"id": 111, "slug": "checkout-api"},
  "scope": {
    "id": 123456, "slug": "production", "domain": "checkout.example.com",
    "domains": [{"name": "www.checkout.example.com"}],
    "nrn": "organization=1:account=1:namespace=11:application=111",
    "dimensions": {},
    "current_active_deployment": "789011",
    "capabilities": {
      "visibility": "public", "protocol": "http", "scaling_type": "autoscaling",
      "fixed_instances": 2, "main_http_port": 8080,
      "cpu_millicores": 500, "cpu_millicores_limit": 1000,
      "ram_memory": 512, "ram_memory_limit": 1024,
      "health_check": {"enabled": true, "type": "http", "path": "/health", "timeout_seconds": 2,
                       "period_seconds": 10, "initial_delay_seconds": 5},
      "additional_ports": [{"port": 9090, "type": "GRPC"}],
      "cron": "*/5 * * * *", "concurrency_policy": "Forbid",
      "history_limit": 3, "retries": 2,
      "autoscaling": {
        "min_replicas": 2, "max_replicas": 10, "target_cpu_utilization": 70,
        "target_memory_enabled": true, "target_memory_utilization": 80
