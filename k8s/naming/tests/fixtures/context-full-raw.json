    }
  },
  "deployment": {"id": 789012, "status": "creating", "strategy_data": {"desired_switched_traffic": 100}},
  "asset": {"url": "public.ecr.aws/acme/checkout-api:1.0.0"},
  "parameters": {
    "results": [
      {
        "type": "file",
        "name": "TLS Certificate",
        "destination_path": "/etc/secrets/tls.pem",
        "values": [{"value": "data:application/x-pem-file;base64,LS0tLS1CRUdJTi0tLS0t"}]
      }
    ]
  },
  "release": {"semver": "1.0.0"},
  "dns_zone_type": "public", "record_type": "A", "gateway_ip": "10.0.0.5",
  "providers": {
    "container-orchestration": {
      "balancer": {"public_name": "alb-public", "private_name": "alb-private"}
