#!/bin/bash

np_name_sanitize() {
	echo "$1" \
		| tr '[:upper:]' '[:lower:]' \
		| sed -e 's/[^a-z0-9-]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'
}

np_name_cap() {
	local available="$1"; shift
	local best=0 cap total len
	for ((cap = 1; cap <= 63; cap++)); do
		total=0
		for len in "$@"; do
			if [ "$len" -lt "$cap" ]; then total=$((total + len)); else total=$((total + cap)); fi
		done
		if [ "$total" -le "$available" ]; then best=$cap; else break; fi
	done
	echo "$best"
}

np_trim_segments() {
	local budget="$1" overhead="$2"; shift 2
	local -a segments=() lengths=()
	local segment clean

	local position=0
	for segment in "$@"; do
		position=$((position + 1))
		clean="$(np_name_sanitize "$segment")"
		if [ -z "$clean" ]; then
			log error "❌ Slug segment $position is empty after sanitising; a Kubernetes name cannot contain an empty component"
			return 1
		fi
		segments+=("$clean")
		lengths+=("${#clean}")
	done

	local available=$((budget - overhead))

	if [ "$available" -le 0 ]; then
		log error "❌ Name budget $budget is too small: separators and ids already need $overhead characters"
		return 1
	fi

	local total=0 len
	for len in "${lengths[@]}"; do total=$((total + len)); done

	if [ "$total" -le "$available" ]; then
		for segment in "${segments[@]}"; do
			echo "$segment"
		done
		return 0
	fi

	local cap
	cap="$(np_name_cap "$available" "${lengths[@]}")"

	if [ "$cap" -lt 3 ]; then
		log error "❌ Name budget $budget leaves $available characters for ${#segments[@]} slug segments, under the 3-character minimum"
		return 1
	fi

	local i
	for ((i = 0; i < ${#segments[@]}; i++)); do
		clean="${segments[$i]:0:$cap}"
		clean="${clean%-}"
		echo "$clean"
	done
}

np_trim_name() {
	local budget="$1" overhead="$2"; shift 2
	local segs
	segs="$(np_trim_segments "$budget" "$overhead" "$@")" || return 1

	local -a trimmed=()
	local line
	while IFS= read -r line; do
		trimmed+=("$line")
	done <<< "$segs"

	local IFS=-
	echo "${trimmed[*]}"
}

NP_NAME_PLACEHOLDERS="application scope namespace account deployment_id scope_id application_id namespace_id"
NP_NAME_FIXED_PLACEHOLDERS="deployment_id scope_id application_id namespace_id"

np_name_value() {
	local upper
	upper="$(echo "$1" | tr '[:lower:]' '[:upper:]')"
	eval "echo \"\${NP_NAME_${upper}:-}\""
}

np_name_is_fixed() {
	case " $NP_NAME_FIXED_PLACEHOLDERS " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

np_name_is_known() {
	case " $NP_NAME_PLACEHOLDERS " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

np_naming_validate_pattern() {
	local pattern="$1" required="$2"
	local rest="$pattern" placeholder first_placeholder="" first_literal="" literal
	local literal_total=0 fixed_total=0 flex_count=0 seen_placeholder=false

	case "$pattern" in
		*"{$required}"*) : ;;
		*)
			log error "❌ Naming pattern '$pattern' does not contain {$required}"
			log error "💡 Possible causes:"
			log error "   - Without a unique id, a new deployment overwrites the previous one and rollback is lost"
			log error "🔧 How to fix:"
			log error "   • Add {$required} to the pattern"
			return 1
			;;
	esac

	while [[ "$rest" =~ ^([^{]*)\{([a-z_]+)\}(.*)$ ]]; do
		literal="${BASH_REMATCH[1]}"
		placeholder="${BASH_REMATCH[2]}"
		rest="${BASH_REMATCH[3]}"
		if [ -z "$first_placeholder" ]; then first_literal="$literal"; fi

		if $seen_placeholder && [ "$literal" != "-" ]; then
			log error "❌ Naming pattern '$pattern' uses '$literal' between placeholders"
			log error "🔧 How to fix:"
			log error "   • Separate placeholders with a single hyphen"
			return 1
		fi

		if ! np_name_is_known "$placeholder"; then
			log error "❌ Unknown naming placeholder {$placeholder}"
			log error "🔧 How to fix:"
			log error "   • Valid placeholders: {application} {scope} {namespace} {account} {deployment_id} {scope_id} {application_id} {namespace_id}"
			return 1
		fi

		literal_total=$((literal_total + ${#literal}))
		if np_name_is_fixed "$placeholder"; then
			local fixed_value
			fixed_value="$(np_name_value "$placeholder")"
			fixed_total=$((fixed_total + ${#fixed_value}))
		else
			flex_count=$((flex_count + 1))
		fi

		if [ -z "$first_placeholder" ]; then first_placeholder="$placeholder"; fi
		seen_placeholder=true
	done
	literal_total=$((literal_total + ${#rest}))

	local head="$first_literal"
	if [ -z "$head" ]; then head="$(np_name_value "$first_placeholder")"; fi

	case "$head" in
		[a-z]*) : ;;
		*)
			log error "❌ Naming pattern '$pattern' renders a name starting with '${head:0:1}'"
			log error "🔧 How to fix:"
			log error "   • Kubernetes names must start with a letter; put a slug placeholder first"
			return 1
			;;
	esac

	if [ "$flex_count" -gt 0 ]; then
		local budget="${NAMING_MAX_LENGTH:-46}"
		local available=$((budget - literal_total - fixed_total))
		local minimum=$((flex_count * 3))
		if [ "$available" -lt "$minimum" ]; then
			log error "❌ Naming pattern '$pattern' consumes most of the $budget-character naming budget in fixed text, leaving nothing for the slugs"
			log error "💡 Possible causes:"
			log error "   - The pattern's literals and fixed ids leave fewer than 3 characters per slug placeholder"
			log error "🔧 How to fix:"
			log error "   • Shorten the pattern's literals or increase the naming budget"
			return 1
		fi
	fi
}

np_name_render() {
	local budget="$1" pattern="$2"
	local rest="$pattern" literal placeholder value
	local overhead=0
	local -a flex=() order=()

	while [[ "$rest" =~ ^([^{]*)\{([a-z_]+)\}(.*)$ ]]; do
		literal="${BASH_REMATCH[1]}"
		placeholder="${BASH_REMATCH[2]}"
		rest="${BASH_REMATCH[3]}"
		overhead=$((overhead + ${#literal}))
		value="$(np_name_value "$placeholder")"
		if np_name_is_fixed "$placeholder"; then
			overhead=$((overhead + ${#value}))
			order+=("FIXED:$value")
		else
			if [ -z "$value" ]; then
				log error "❌ Naming placeholder {$placeholder} resolves to an empty value"
				log error "🔧 How to fix:"
				log error "   • Ensure this entity has a slug in this context, or remove {$placeholder} from the pattern"
				return 1
			fi
			flex+=("$value")
			order+=("FLEX")
		fi
	done
	overhead=$((overhead + ${#rest}))

	local segs
	segs="$(np_trim_segments "$budget" "$overhead" "${flex[@]}")" || return 1

	local -a trimmed_flex=()
	local line
	while IFS= read -r line; do
		trimmed_flex+=("$line")
	done <<< "$segs"

	local out="" item flex_i=0
	for item in "${order[@]}"; do
		if [ -n "$out" ]; then out="$out-"; fi
		case "$item" in
			FIXED:*) out="$out${item#FIXED:}" ;;
			FLEX)    out="$out${trimmed_flex[$flex_i]}"; flex_i=$((flex_i + 1)) ;;
		esac
	done

	echo "$out"
}

np_naming_strategy() {
	if [ -n "${NAMING_STRATEGY+x}" ] && [ -z "$NAMING_STRATEGY" ]; then
		log error "❌ NAMING_STRATEGY is set but empty"
		log error "🔧 How to fix:"
		log error "   • Remove it to use the default 'ids', or set one of: ids, qualified, custom"
		return 1
	fi

	local strategy
	strategy="$(get_config_value \
		--provider '.providers["scope-configurations"].naming.strategy' \
		--provider '.providers["container-orchestration"].naming.strategy' \
		--env NAMING_STRATEGY \
		--default "ids")"

	case "$strategy" in
		ids|qualified|custom) echo "$strategy" ;;
		*)
			log error "❌ Unknown naming strategy '$strategy'"
			log error "🔧 How to fix:"
			log error "   • Valid strategies: ids, qualified, custom"
			return 1
			;;
	esac
}

np_naming_resolve() {
	local strategy
	strategy="$(np_naming_strategy)" || return 1

	NP_NAME_APPLICATION="$(echo "$CONTEXT" | jq -r '.application.slug // ""')"
	NP_NAME_SCOPE="$(echo "$CONTEXT" | jq -r '.scope.slug // ""')"
	NP_NAME_NAMESPACE="$(echo "$CONTEXT" | jq -r '.namespace.slug // ""')"
	NP_NAME_ACCOUNT="$(echo "$CONTEXT" | jq -r '.account.slug // ""')"
	NP_NAME_DEPLOYMENT_ID="$(echo "$CONTEXT" | jq -r '.deployment.id // ""')"
	NP_NAME_SCOPE_ID="$(echo "$CONTEXT" | jq -r '.scope.id // ""')"
	NP_NAME_APPLICATION_ID="$(echo "$CONTEXT" | jq -r '.application.id // ""')"
	NP_NAME_NAMESPACE_ID="$(echo "$CONTEXT" | jq -r '.namespace.id // ""')"
	export NP_NAME_APPLICATION NP_NAME_SCOPE NP_NAME_NAMESPACE NP_NAME_ACCOUNT
	export NP_NAME_DEPLOYMENT_ID NP_NAME_SCOPE_ID NP_NAME_APPLICATION_ID NP_NAME_NAMESPACE_ID

	local visibility
	visibility="$(echo "$CONTEXT" | jq -r '.ingress_visibility // ""')"

	if [ "$strategy" = "ids" ]; then
		np_naming_roles_ids "$visibility"
	else
		np_naming_roles_patterned "$strategy"
	fi
}

np_naming_roles_ids() {
	local visibility="$1"
	local s="$NP_NAME_SCOPE_ID" d="$NP_NAME_DEPLOYMENT_ID"
	local base_d="" scope_base="k-8-s-$NP_NAME_SCOPE-$s"
	local blue

	if [ -n "$d" ]; then base_d="d-$s-$d"; fi
	blue="$(echo "$CONTEXT" | jq -r '.blue_deployment_id // ""')"

	local dns_app="${NP_NAME_APPLICATION:0:20}" dns_scope="${NP_NAME_SCOPE:0:20}"
	dns_app="${dns_app%-}"
	dns_scope="${dns_scope%-}"

	np_naming_emit \
		"$base_d" \
		"${base_d:+hpa-$base_d}" \
		"${base_d:+pdb-$base_d}" \
		"${d:+s-$s-d-$d}" \
		"${d:+s-$s-d-$d-files}" \
		"${d:+job-$s-$d}" \
		"$scope_base-$visibility" \
		"k8s-$dns_app-$dns_scope-$s-dns" \
		"d-$s" \
		"$scope_base" \
		"${blue:+d-$s-$blue}" \
		"ids" "$visibility"
}

np_naming_emit() {
	local deployment="$1" hpa="$2" pdb="$3" secret="$4" secret_files="$5" \
	      cronjob="$6" ingress="$7" dns="$8" cert="$9" ingress_base="${10}" \
	      blue="${11}" strategy="${12}" visibility="${13}"

	local ports
	ports="$(echo "$CONTEXT" | jq -c \
		--arg base_d "$deployment" --arg scope_base "$ingress_base" \
		--arg visibility "$visibility" --arg strategy "$strategy" --arg blue_d "$blue" '
		[ (.scope.capabilities.additional_ports // [])[]
		  | . + {
		      service_name: (if $base_d == "" then "" else
		        $base_d + "-" + (if .type == "HTTP" then "http" else "grpc" end) + "-" + (.port|tostring) end),
		      blue_service_name: (if $blue_d == "" then "" else
		        $blue_d + "-" + (if .type == "HTTP" then "http" else "grpc" end) + "-" + (.port|tostring) end),
		      ingress_name: (
		        $scope_base + "-" + (if .type == "HTTP" then "http" else "grpc" end) + "-" + (.port|tostring)
		        + (if $strategy == "ids" then "-" + $visibility else "" end))
		    } ]')"

	jq -n \
		--arg deployment "$deployment" --arg service "$deployment" \
		--arg hpa "$hpa" --arg pdb "$pdb" --arg secret "$secret" \
		--arg secret_files "$secret_files" --arg cronjob "$cronjob" \
		--arg scope_ingress "$ingress" --arg scope_dns "$dns" --arg serving_cert "$cert" \
		--arg blue "$blue" \
		--argjson additional_ports "$ports" \
		'{deployment: $deployment, service: $service, hpa: $hpa, pdb: $pdb,
		  secret: $secret, secret_files: $secret_files, cronjob: $cronjob,
		  scope_ingress: $scope_ingress, scope_dns: $scope_dns,
		  serving_cert: $serving_cert,
		  blue_deployment: $blue, blue_service: $blue,
		  additional_ports: $additional_ports}'
}

NP_NAMING_DEPLOYMENT_PATTERN_DEFAULT="{application}-{scope}-{deployment_id}"
NP_NAMING_SCOPE_PATTERN_DEFAULT="{application}-{scope}-{scope_id}"
NP_NAMING_SCOPE_BUDGET=52

np_naming_roles_patterned() {
	local strategy="$1"
	local deployment_pattern="$NP_NAMING_DEPLOYMENT_PATTERN_DEFAULT"
	local scope_pattern="$NP_NAMING_SCOPE_PATTERN_DEFAULT"

	if [ "$strategy" = "custom" ]; then
		deployment_pattern="$(get_config_value \
			--provider '.providers["scope-configurations"].naming.deployment_pattern' \
			--provider '.providers["container-orchestration"].naming.deployment_pattern' \
			--env NAMING_DEPLOYMENT_PATTERN \
			--default "$NP_NAMING_DEPLOYMENT_PATTERN_DEFAULT")"
		scope_pattern="$(get_config_value \
			--provider '.providers["scope-configurations"].naming.scope_pattern' \
			--provider '.providers["container-orchestration"].naming.scope_pattern' \
			--env NAMING_SCOPE_PATTERN \
			--default "$NP_NAMING_SCOPE_PATTERN_DEFAULT")"
	fi

	np_naming_validate_pattern "$scope_pattern" "scope_id" || return 1

	local base_s base_d=""
	base_s="$(np_name_render "$NP_NAMING_SCOPE_BUDGET" "$scope_pattern")" || return 1

	local existing discover_status
	existing="$(np_naming_discover_scope "${K8S_NAMESPACE:-nullplatform}" "$NP_NAME_SCOPE_ID")"
	discover_status=$?

	case "$discover_status" in
		0)
			log info "✅ Keeping the existing scope object name '$existing'" >&2
			base_s="$existing"
			;;
		2) ;;
		*)
			log error "❌ Could not check the cluster for the scope's existing Kubernetes object name"
			log error ""
			log error "💡 Possible causes:"
			log error "   - The cluster API server is unreachable"
			log error "   - RBAC denies listing ingress/httproute in namespace '${K8S_NAMESPACE:-nullplatform}'"
			log error "   - A requested resource type (e.g. httproute) has no CRD installed, failing the combined get"
			log error "🔧 How to fix:"
			log error "   • Verify cluster connectivity and RBAC for ingress/httproute"
			log error "   • Retry once the API server is reachable"
			return 1
			;;
	esac

	if [ -n "$NP_NAME_DEPLOYMENT_ID" ]; then
		np_naming_validate_pattern "$deployment_pattern" "deployment_id" || return 1
		base_d="$(np_name_render "${NAMING_MAX_LENGTH:-46}" "$deployment_pattern")" || return 1
	fi

	np_naming_emit \
		"$base_d" \
		"${base_d:+hpa-$base_d}" \
		"${base_d:+pdb-$base_d}" \
		"${base_d:+$base_d-env}" \
		"${base_d:+$base_d-files}" \
		"${base_d:+job-$base_d}" \
		"$base_s" \
		"$base_s-dns" \
		"$base_s" \
		"$base_s" \
		"" \
		"$strategy" ""
}

np_naming_lookup() {
	local kind="$1" namespace="$2" deployment_id="$3" found
	found="$(kubectl get "$kind" -n "$namespace" -l "deployment_id=$deployment_id" \
		-o jsonpath='{.items[0].metadata.name}' 2>/dev/null)"
	if [ -z "$found" ]; then return 1; fi
	echo "$found"
}

np_naming_discover_scope() {
	local namespace="$1" scope_id="$2"
	local main_port
	main_port="$(echo "$CONTEXT" | jq -r '.scope.capabilities.main_http_port // 8080')"

	local raw
	raw="$(kubectl get ingress,httproute -n "$namespace" -l "scope_id=$scope_id" -o json 2>/dev/null)"
	if [ $? -ne 0 ]; then
		return 1
	fi

	local found
	found="$(echo "$raw" | jq -r --argjson main "$main_port" '
		[ (.items // [])[]
		  | select(
		      .kind == "HTTPRoute"
		      or (try ([.spec.rules[].http.paths[].backend.service.port.number] | any(. == $main)) catch false)
		    )
		] | (.[0].metadata.name // empty)
	')"

	if [ -z "$found" ]; then
		return 2
	fi

	echo "$found"
}

np_naming_discover_blue() {
	local namespace="$1" blue_id="$2" main_port="$3"

	if [ -z "$blue_id" ] || [ "$blue_id" = "null" ]; then
		jq -n '{deployment: "", service: "", ports: {}}'
		return 0
	fi

	local services deployments
	services="$(kubectl get service -n "$namespace" -l "deployment_id=$blue_id" -o json 2>/dev/null)"
	if [ -z "$services" ]; then services='{"items":[]}'; fi
	deployments="$(kubectl get deployment -n "$namespace" -l "deployment_id=$blue_id" -o json 2>/dev/null)"
	if [ -z "$deployments" ]; then deployments='{"items":[]}'; fi

	jq -n --argjson svc "$services" --argjson dep "$deployments" --argjson main "$main_port" '
		{
			deployment: ($dep.items[0].metadata.name // ""),
			service: ([$svc.items[] | select(.spec.ports[0].port == $main) | .metadata.name] | first // ""),
			ports: ([$svc.items[]
				| select(.spec.ports[0].port != $main)
				| {key: (.spec.ports[0].port|tostring),
				   value: .metadata.name}] | from_entries)
		}'
}
