#!/bin/bash

np_name_sanitize() {
	echo "$1" \
		| tr '[:upper:]' '[:lower:]' \
		| sed -e 's/[^a-z0-9-]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//'
}

np_name_cap() {
	local available="$1"; shift
	local best=0 cap total len
	for ((cap = 1; cap <= 63; cap++)); do
		total=0
		for len in "$@"; do
			if [ "$len" -lt "$cap" ]; then total=$((total + len)); else total=$((total + cap)); fi
		done
		if [ "$total" -le "$available" ]; then best=$cap; else break; fi
	done
	echo "$best"
}

np_trim_segments() {
	local budget="$1" overhead="$2"; shift 2
	local -a segments=() lengths=()
	local segment clean

	local position=0
	for segment in "$@"; do
		position=$((position + 1))
		clean="$(np_name_sanitize "$segment")"
		if [ -z "$clean" ]; then
			log error "❌ Slug segment $position is empty after sanitising; a Kubernetes name cannot contain an empty component"
			return 1
		fi
		segments+=("$clean")
		lengths+=("${#clean}")
	done

	local available=$((budget - overhead))

	if [ "$available" -le 0 ]; then
		log error "❌ Name budget $budget is too small: separators and ids already need $overhead characters"
		return 1
	fi

	local total=0 len
	for len in "${lengths[@]}"; do total=$((total + len)); done

	if [ "$total" -le "$available" ]; then
		for segment in "${segments[@]}"; do
			echo "$segment"
		done
		return 0
	fi

	local cap
	cap="$(np_name_cap "$available" "${lengths[@]}")"

	if [ "$cap" -lt 3 ]; then
		log error "❌ Name budget $budget leaves $available characters for ${#segments[@]} slug segments, under the 3-character minimum"
		return 1
	fi

	local i
	for ((i = 0; i < ${#segments[@]}; i++)); do
		clean="${segments[$i]:0:$cap}"
		clean="${clean%-}"
		echo "$clean"
	done
}

NP_NAMING_PATH_PATTERN='^\.[A-Za-z0-9_]+(\.[A-Za-z0-9_]+|\["[A-Za-z0-9_-]+"\])*$'

np_naming_resolve_path() {
	echo "$CONTEXT" | jq -r "$1 // \"\""
}

np_name_render() {
	local budget="$1" pattern="$2" required="${3:-}"
	local rest="$pattern" literal path value
	local first_path="" first_literal="" first_value=""
	local literal_total=0 fixed_total=0 flex_count=0 seen_placeholder=false
	local overhead=0
	local -a flex=() order=() literals=()

	if [ -n "$required" ]; then
		case "$pattern" in
			*"{.$required}"*) : ;;
			*)
				log error "❌ Naming pattern '$pattern' does not contain {.$required}"
				log error "💡 Possible causes:"
				log error "   - Without a unique id, a new deployment overwrites the previous one and rollback is lost"
				log error "🔧 How to fix:"
				log error "   • Add {.$required} to the pattern"
				return 1
				;;
		esac
	fi

	while [[ "$rest" =~ ^([^{]*)\{([^}]*)\}(.*)$ ]]; do
		literal="${BASH_REMATCH[1]}"
		path="${BASH_REMATCH[2]}"
		rest="${BASH_REMATCH[3]}"
		if [ -z "$first_path" ]; then first_literal="$literal"; fi

		if $seen_placeholder; then
			if [ "$literal" != "-" ]; then
				log error "❌ Naming pattern '$pattern' uses '$literal' between placeholders"
				log error "🔧 How to fix:"
				log error "   • Separate placeholders with a single hyphen"
				return 1
			fi
		elif [[ -n "$literal" && ! "$literal" =~ ^[a-z0-9-]+$ ]]; then
			log error "❌ Naming pattern '$pattern' has an invalid leading literal '$literal'"
			log error "🔧 How to fix:"
			log error "   • Use only lowercase letters, digits and hyphens before the first placeholder"
			return 1
		fi

		if ! [[ "$path" =~ $NP_NAMING_PATH_PATTERN ]]; then
			log error "❌ Naming pattern '$pattern' has an unsafe path {$path}"
			log error "🔧 How to fix:"
			log error "   • Use dotted field access, e.g. {.scope.capabilities.main_http_port}"
			return 1
		fi

		overhead=$((overhead + ${#literal}))
		literals+=("$literal")

		value="$(np_naming_resolve_path "$path")"
		if [ -z "$value" ]; then
			log error "❌ Naming path {$path} resolves to an empty value"
			log error "🔧 How to fix:"
			log error "   • Ensure this field is present in the context, or remove {$path} from the pattern"
			return 1
		fi

		if [ -z "$first_path" ]; then first_path="$path"; first_value="$value"; fi

		literal_total=$((literal_total + ${#literal}))
		if [[ "$value" =~ ^[0-9]+$ ]]; then
			fixed_total=$((fixed_total + ${#value}))
			overhead=$((overhead + ${#value}))
			order+=("FIXED:$value")
		else
			flex_count=$((flex_count + 1))
			flex+=("$value")
			order+=("FLEX")
		fi

		seen_placeholder=true
	done
	overhead=$((overhead + ${#rest}))
	literal_total=$((literal_total + ${#rest}))
	literals+=("$rest")

	if [[ -n "$rest" && ! "$rest" =~ ^[a-z0-9-]+$ ]]; then
		log error "❌ Naming pattern '$pattern' has an invalid trailing literal '$rest'"
		log error "🔧 How to fix:"
		log error "   • Use only lowercase letters, digits and hyphens after the last placeholder"
		return 1
	fi

	local head="$first_literal"
	if [ -z "$head" ]; then head="$first_value"; fi

	case "$head" in
		[a-z]*) : ;;
		*)
			log error "❌ Naming pattern '$pattern' renders a name starting with '${head:0:1}'"
			log error "🔧 How to fix:"
			log error "   • Kubernetes names must start with a letter; put a slug placeholder first"
			return 1
			;;
	esac

	if [ "$flex_count" -gt 0 ]; then
		local validate_budget="${NAMING_MAX_LENGTH:-46}"
		local available=$((validate_budget - literal_total - fixed_total))
		local minimum=$((flex_count * 3))
		if [ "$available" -lt "$minimum" ]; then
			log error "❌ Naming pattern '$pattern' consumes most of the $validate_budget-character naming budget in fixed text, leaving nothing for the slugs"
			log error "💡 Possible causes:"
			log error "   - The pattern's literals and fixed ids leave fewer than 3 characters per slug placeholder"
			log error "🔧 How to fix:"
			log error "   • Shorten the pattern's literals or increase the naming budget"
			return 1
		fi
	fi

	local segs
	segs="$(np_trim_segments "$budget" "$overhead" "${flex[@]}")" || return 1

	local -a trimmed_flex=()
	local line
	while IFS= read -r line; do
		trimmed_flex+=("$line")
	done <<< "$segs"

	local out="" item flex_i=0 literal_i=0
	for item in "${order[@]}"; do
		out="$out${literals[$literal_i]}"
		literal_i=$((literal_i + 1))
		case "$item" in
			FIXED:*) out="$out${item#FIXED:}" ;;
			FLEX)    out="$out${trimmed_flex[$flex_i]}"; flex_i=$((flex_i + 1)) ;;
		esac
	done
	out="$out${literals[$literal_i]}"

	echo "$out"
}

np_naming_validate_pattern() {
	local pattern="$1" required="$2"
	np_name_render "${NAMING_MAX_LENGTH:-46}" "$pattern" "$required" > /dev/null
}

np_naming_strategy() {
	if [ -n "${NAMING_STRATEGY+x}" ] && [ -z "$NAMING_STRATEGY" ]; then
		log error "❌ NAMING_STRATEGY is set but empty"
		log error "🔧 How to fix:"
		log error "   • Remove it to use the default 'ids', or set one of: ids, qualified, custom"
		return 1
	fi

	local strategy
	strategy="$(get_config_value \
		--provider '.providers["scope-configurations"].naming.strategy' \
		--provider '.providers["container-orchestration"].naming.strategy' \
		--env NAMING_STRATEGY \
		--default "ids")"

	case "$strategy" in
		ids|qualified|custom) echo "$strategy" ;;
		*)
			log error "❌ Unknown naming strategy '$strategy'"
			log error "🔧 How to fix:"
			log error "   • Valid strategies: ids, qualified, custom"
			return 1
			;;
	esac
}

np_naming_resolve() {
	local strategy
	strategy="$(np_naming_strategy)" || return 1

	NP_NAME_APPLICATION="$(echo "$CONTEXT" | jq -r '.application.slug // ""')"
	NP_NAME_SCOPE="$(echo "$CONTEXT" | jq -r '.scope.slug // ""')"
	NP_NAME_NAMESPACE="$(echo "$CONTEXT" | jq -r '.namespace.slug // ""')"
	NP_NAME_ACCOUNT="$(echo "$CONTEXT" | jq -r '.account.slug // ""')"
	NP_NAME_DEPLOYMENT_ID="$(echo "$CONTEXT" | jq -r '.deployment.id // ""')"
	NP_NAME_SCOPE_ID="$(echo "$CONTEXT" | jq -r '.scope.id // ""')"
	NP_NAME_APPLICATION_ID="$(echo "$CONTEXT" | jq -r '.application.id // ""')"
	NP_NAME_NAMESPACE_ID="$(echo "$CONTEXT" | jq -r '.namespace.id // ""')"
	export NP_NAME_APPLICATION NP_NAME_SCOPE NP_NAME_NAMESPACE NP_NAME_ACCOUNT
	export NP_NAME_DEPLOYMENT_ID NP_NAME_SCOPE_ID NP_NAME_APPLICATION_ID NP_NAME_NAMESPACE_ID

	local visibility
	visibility="$(echo "$CONTEXT" | jq -r '.ingress_visibility // ""')"

	if [ "$strategy" = "ids" ]; then
		np_naming_roles_ids "$visibility"
	else
		np_naming_roles_patterned "$strategy"
	fi
}

np_naming_roles_ids() {
	local visibility="$1"
	local s="$NP_NAME_SCOPE_ID" d="$NP_NAME_DEPLOYMENT_ID"
	local base_d="" scope_base="k-8-s-$NP_NAME_SCOPE-$s"
	local blue

	if [ -n "$d" ]; then base_d="d-$s-$d"; fi
	blue="$(echo "$CONTEXT" | jq -r '.blue_deployment_id // ""')"

	local dns_app="${NP_NAME_APPLICATION:0:20}" dns_scope="${NP_NAME_SCOPE:0:20}"
	dns_app="${dns_app%-}"
	dns_scope="${dns_scope%-}"

	np_naming_emit "$(jq -n \
		--arg deployment "$base_d" \
		--arg hpa "${base_d:+hpa-$base_d}" \
		--arg pdb "${base_d:+pdb-$base_d}" \
		--arg secret "${d:+s-$s-d-$d}" \
		--arg secret_files "${d:+s-$s-d-$d-files}" \
		--arg cronjob "${d:+job-$s-$d}" \
		--arg ingress "$scope_base-$visibility" \
		--arg dns "k8s-$dns_app-$dns_scope-$s-dns" \
		--arg cert "d-$s" \
		--arg ingress_base "$scope_base" \
		--arg blue "${blue:+d-$s-$blue}" \
		--arg strategy "ids" \
		--arg visibility "$visibility" \
		'{deployment:$deployment, hpa:$hpa, pdb:$pdb, secret:$secret, secret_files:$secret_files,
		  cronjob:$cronjob, ingress:$ingress, dns:$dns, cert:$cert, ingress_base:$ingress_base,
		  blue:$blue, strategy:$strategy, visibility:$visibility}')"
}

np_naming_emit() {
	local fields="$1"

	local ports
	ports="$(echo "$CONTEXT" | jq -c \
		--argjson f "$fields" '
		($f.deployment) as $base_d | ($f.ingress_base) as $scope_base |
		($f.visibility) as $visibility | ($f.strategy) as $strategy | ($f.blue) as $blue_d |
		[ (.scope.capabilities.additional_ports // [])[]
		  | . + {
		      service_name: (if $base_d == "" then "" else
		        $base_d + "-" + (if .type == "HTTP" then "http" else "grpc" end) + "-" + (.port|tostring) end),
		      blue_service_name: (if $blue_d == "" then "" else
		        $blue_d + "-" + (if .type == "HTTP" then "http" else "grpc" end) + "-" + (.port|tostring) end),
		      ingress_name: (
		        $scope_base + "-" + (if .type == "HTTP" then "http" else "grpc" end) + "-" + (.port|tostring)
		        + (if $strategy == "ids" then "-" + $visibility else "" end))
		    } ]')"

	jq -n \
		--argjson f "$fields" \
		--argjson additional_ports "$ports" \
		'{deployment: $f.deployment, service: $f.deployment, hpa: $f.hpa, pdb: $f.pdb,
		  secret: $f.secret, secret_files: $f.secret_files, cronjob: $f.cronjob,
		  scope_ingress: $f.ingress, scope_dns: $f.dns,
		  serving_cert: $f.cert,
		  blue_deployment: $f.blue, blue_service: $f.blue,
		  additional_ports: $additional_ports}'
}

NP_NAMING_DEPLOYMENT_PATTERN_DEFAULT="{.application.slug}-{.scope.slug}-{.deployment.id}"
NP_NAMING_SCOPE_PATTERN_DEFAULT="{.application.slug}-{.scope.slug}-{.scope.id}"
NP_NAMING_SCOPE_BUDGET=52

np_naming_roles_patterned() {
	local strategy="$1"
	local deployment_pattern="$NP_NAMING_DEPLOYMENT_PATTERN_DEFAULT"
	local scope_pattern="$NP_NAMING_SCOPE_PATTERN_DEFAULT"

	if [ "$strategy" = "custom" ]; then
		deployment_pattern="$(get_config_value \
			--provider '.providers["scope-configurations"].naming.deployment_pattern' \
			--provider '.providers["container-orchestration"].naming.deployment_pattern' \
			--env NAMING_DEPLOYMENT_PATTERN \
			--default "$NP_NAMING_DEPLOYMENT_PATTERN_DEFAULT")"
		scope_pattern="$(get_config_value \
			--provider '.providers["scope-configurations"].naming.scope_pattern' \
			--provider '.providers["container-orchestration"].naming.scope_pattern' \
			--env NAMING_SCOPE_PATTERN \
			--default "$NP_NAMING_SCOPE_PATTERN_DEFAULT")"
	fi

	local base_s base_d=""
	base_s="$(np_name_render "$NP_NAMING_SCOPE_BUDGET" "$scope_pattern" "scope.id")" || return 1

	local existing discover_status
	existing="$(np_naming_discover_scope "${K8S_NAMESPACE:-nullplatform}" "$NP_NAME_SCOPE_ID" "$base_s")"
	discover_status=$?

	case "$discover_status" in
		0)
			log info "✅ Keeping the existing scope object name '$existing'" >&2
			base_s="$existing"
			;;
		2) ;;
		*)
			log error "❌ Could not check the cluster for the scope's existing Kubernetes object name"
			log error ""
			log error "💡 Possible causes:"
			log error "   - The cluster API server is unreachable"
			log error "   - RBAC denies reading ingress/httproute in namespace '${K8S_NAMESPACE:-nullplatform}'"
			log error "🔧 How to fix:"
			log error "   • Verify cluster connectivity and RBAC for ingress/httproute"
			log error "   • Retry once the API server is reachable"
			return 1
			;;
	esac

	local base_dns="$base_s-dns"
	if [ "${DNS_TYPE:-}" = "external_dns" ]; then
		local existing_dns dns_discover_status
		existing_dns="$(np_naming_discover_dns "${K8S_NAMESPACE:-nullplatform}" "$NP_NAME_SCOPE_ID")"
		dns_discover_status=$?

		case "$dns_discover_status" in
			0)
				log info "✅ Keeping the existing scope DNS object name '$existing_dns'" >&2
				base_dns="$existing_dns"
				;;
			2) ;;
			*)
				log error "❌ Could not check the cluster for the scope's existing DNSEndpoint name"
				log error ""
				log error "💡 Possible causes:"
				log error "   - The cluster API server is unreachable"
				log error "   - RBAC denies reading dnsendpoint in namespace '${K8S_NAMESPACE:-nullplatform}'"
				log error "🔧 How to fix:"
				log error "   • Verify cluster connectivity and RBAC for dnsendpoint"
				log error "   • Retry once the API server is reachable"
				return 1
				;;
		esac
	fi

	if [ -n "$NP_NAME_DEPLOYMENT_ID" ]; then
		base_d="$(np_name_render "${NAMING_MAX_LENGTH:-46}" "$deployment_pattern" "deployment.id")" || return 1
	fi

	np_naming_emit "$(jq -n \
		--arg deployment "$base_d" \
		--arg hpa "${base_d:+hpa-$base_d}" \
		--arg pdb "${base_d:+pdb-$base_d}" \
		--arg secret "${base_d:+$base_d-env}" \
		--arg secret_files "${base_d:+$base_d-files}" \
		--arg cronjob "${base_d:+job-$base_d}" \
		--arg ingress "$base_s" \
		--arg dns "$base_dns" \
		--arg cert "$base_s" \
		--arg ingress_base "$base_s" \
		--arg blue "" \
		--arg strategy "$strategy" \
		--arg visibility "" \
		'{deployment:$deployment, hpa:$hpa, pdb:$pdb, secret:$secret, secret_files:$secret_files,
		  cronjob:$cronjob, ingress:$ingress, dns:$dns, cert:$cert, ingress_base:$ingress_base,
		  blue:$blue, strategy:$strategy, visibility:$visibility}')"
}

np_naming_lookup() {
	local kind="$1" namespace="$2" deployment_id="$3"
	local found status
	found="$(kubectl get "$kind" -n "$namespace" -l "deployment_id=$deployment_id" \
		-o jsonpath='{.items[0].metadata.name}' 2>&1)"
	status=$?

	if [ "$status" -ne 0 ]; then
		case "$found" in
			*"doesn't have a resource type"*) return 2 ;;
			*) return 1 ;;
		esac
	fi

	if [ -z "$found" ]; then
		return 2
	fi

	echo "$found"
}

np_naming_list_by_label() {
	local kind="$1" namespace="$2" label="$3"
	local out status
	out="$(kubectl get "$kind" -n "$namespace" -l "$label" -o jsonpath='{.items[*].metadata.name}' 2>&1)"
	status=$?

	if [ "$status" -ne 0 ]; then
		case "$out" in
			*"doesn't have a resource type"*) return 2 ;;
			*) return 1 ;;
		esac
	fi

	if [ -z "$out" ]; then
		return 2
	fi

	echo "$out"
}

np_naming_pick_main() {
	local names="$1" exclude="$2"
	local name
	for name in $names; do
		case " $exclude " in
			*" $name "*) ;;
			*) echo "$name"; return 0 ;;
		esac
	done
	return 2
}

np_naming_port_exclusions() {
	local scope_id="$1" current_base="$2"
	local visibility legacy_base
	visibility="$(echo "$CONTEXT" | jq -r '.ingress_visibility // ""')"
	legacy_base="k-8-s-$NP_NAME_SCOPE-$scope_id"

	echo "$CONTEXT" | jq -r \
		--arg legacy "$legacy_base" --arg visibility "$visibility" --arg current "$current_base" '
		(.scope.capabilities.additional_ports // [])[] |
		(if .type == "HTTP" then "http" else "grpc" end) as $t |
		"\($legacy)-\($t)-\(.port)-\($visibility)",
		"\($current)-\($t)-\(.port)"
	' | tr '\n' ' '
}

np_naming_discover_scope() {
	local namespace="$1" scope_id="$2" current_base="$3"
	local exclude names status

	exclude="$(np_naming_port_exclusions "$scope_id" "$current_base")"

	names="$(np_naming_list_by_label ingress "$namespace" "scope_id=$scope_id")"
	status=$?
	case "$status" in
		0) np_naming_pick_main "$names" "$exclude" && return 0 ;;
		1) return 1 ;;
	esac

	names="$(np_naming_list_by_label httproute "$namespace" "scope_id=$scope_id")"
	status=$?
	case "$status" in
		0) np_naming_pick_main "$names" "$exclude" && return 0 ;;
		1) return 1 ;;
	esac

	return 2
}

np_naming_discover_dns() {
	local namespace="$1" scope_id="$2"
	local out status
	out="$(kubectl get dnsendpoint -n "$namespace" -l "scope_id=$scope_id" \
		-o jsonpath='{.items[0].metadata.name}' 2>&1)"
	status=$?

	if [ "$status" -ne 0 ]; then
		case "$out" in
			*"doesn't have a resource type"*) return 2 ;;
			*) return 1 ;;
		esac
	fi

	if [ -z "$out" ]; then
		return 2
	fi

	echo "$out"
}

np_naming_discover_blue() {
	local namespace="$1" blue_id="$2" main_port="$3"

	if [ -z "$blue_id" ] || [ "$blue_id" = "null" ]; then
		jq -n '{deployment: "", service: "", ports: {}}'
		return 0
	fi

	local services deployments
	services="$(kubectl get service -n "$namespace" -l "deployment_id=$blue_id" -o json 2>/dev/null)"
	if [ -z "$services" ]; then services='{"items":[]}'; fi
	deployments="$(kubectl get deployment -n "$namespace" -l "deployment_id=$blue_id" -o json 2>/dev/null)"
	if [ -z "$deployments" ]; then deployments='{"items":[]}'; fi

	jq -n --argjson svc "$services" --argjson dep "$deployments" --argjson main "$main_port" '
		{
			deployment: ($dep.items[0].metadata.name // ""),
			service: ([$svc.items[] | select(.spec.ports[0].port == $main) | .metadata.name] | first // ""),
			ports: ([$svc.items[]
				| select(.spec.ports[0].port != $main)
				| {key: (.spec.ports[0].port|tostring),
				   value: .metadata.name}] | from_entries)
		}'
}

np_naming_apply_to_context() {
	export NEW_DEPLOYMENT_ID=$DEPLOYMENT_ID
	export DEPLOYMENT_ID=$(echo "$CONTEXT" | jq .scope.current_active_deployment -r)

	ORIGINAL_CONTEXT="$CONTEXT"

	CONTEXT=$(echo "$CONTEXT" | jq \
		--arg deployment_id "$DEPLOYMENT_ID" \
		'.deployment.id = $deployment_id')

	RESOLVED_NAMES=$(np_naming_resolve) || return 1

	CONTEXT=$(echo "$CONTEXT" | jq --argjson names "$RESOLVED_NAMES" '
		.names.deployment = $names.deployment
		| .names.service = $names.service
		| .names.hpa = $names.hpa
		| .names.pdb = $names.pdb
		| .names.secret = $names.secret
		| .names.secret_files = $names.secret_files
		| .names.cronjob = $names.cronjob
		| .scope.capabilities.additional_ports = (
			(.scope.capabilities.additional_ports // []) as $old
			| ($names.additional_ports // []) as $new
			| [ $old[] as $o
				| (($new[] | select(.port == $o.port and .type == $o.type) | .service_name) // $o.service_name) as $svc
				| $o + {service_name: $svc}
			]
		)
	')
}
