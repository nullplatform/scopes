#!/bin/bash

DEPLOYMENT_STATUS_READ_ATTEMPTS="${DEPLOYMENT_STATUS_READ_ATTEMPTS:-3}"
DEPLOYMENT_STATUS_READ_RETRY_SECONDS="${DEPLOYMENT_STATUS_READ_RETRY_SECONDS:-2}"

DS_OK=0
DS_CLI_ERROR=1
DS_NO_STATUS=2

export DEPLOYMENT_STATUS="" DEPLOYMENT_STATUS_ERROR=""

deployment_status_read() {
  local out rc attempt
  DEPLOYMENT_STATUS=""
  DEPLOYMENT_STATUS_ERROR=""
  for ((attempt = 1; attempt <= DEPLOYMENT_STATUS_READ_ATTEMPTS; attempt++)); do
    if out=$(np deployment read --id "$DEPLOYMENT_ID" --format json 2>&1); then
      if DEPLOYMENT_STATUS=$(jq -er '.status | select(type == "string" and length > 0)' <<<"$out" 2>/dev/null); then
        DEPLOYMENT_STATUS_ERROR=""
        return "$DS_OK"
      fi
      DEPLOYMENT_STATUS=""
      DEPLOYMENT_STATUS_ERROR="no status in the response"
      rc=$DS_NO_STATUS
    else
      DEPLOYMENT_STATUS_ERROR="$out"
      rc=$DS_CLI_ERROR
    fi
    if [ "$attempt" -lt "$DEPLOYMENT_STATUS_READ_ATTEMPTS" ]; then
      sleep "$DEPLOYMENT_STATUS_READ_RETRY_SECONDS"
    fi
  done
  return "$rc"
}

deployment_action_applied_statuses() {
  case "$1" in
    start-initial|start-blue-green|switch-traffic) echo "finalizing finalized" ;;
    finalize-blue-green) echo "finalized" ;;
    rollback-deployment) echo "rolled_back cancelled" ;;
    delete-deployment) echo "deleted" ;;
  esac
}

deployment_action_already_applied() {
  local statuses
  statuses=$(deployment_action_applied_statuses "$1")
  [[ -n "$statuses" && " $statuses " == *" $2 "* ]]
}
