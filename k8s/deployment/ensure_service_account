#!/bin/bash
# With IAM.MODE gke, every scope of an application in an environment runs as
# the service account np-<application id>-<environment>. The scope's create
# workflow builds it, but a scope created before the mode was turned on has
# none, and its next deployment would ask for a service account that does not
# exist (Kubernetes refuses the pods). Build the same manifest here, so the
# deployment's apply step creates it first. Any other mode: nothing to do.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

IAM=${IAM-"{}"}

if [[ "$(echo "$IAM" | jq -r '.ENABLED // false')" != "true" ]] ||
  [[ "$(echo "$IAM" | jq -r '.MODE // "irsa"')" != "gke" ]]; then
  log debug "📋 IAM mode is not gke, the deployment uses the scope's own service account setup"
  return 0
fi

# The scope workflows carry the namespace in the context; the deployment's
# build context exports it as K8S_NAMESPACE.
if [[ "$(echo "$CONTEXT" | jq -r '.k8s_namespace // ""')" == "" ]]; then
  CONTEXT=$(echo "$CONTEXT" | jq --arg ns "$K8S_NAMESPACE" '. + {k8s_namespace: $ns}')
fi

export ACTION=create
# shellcheck source=/dev/null
source "$SCRIPT_DIR/../scope/iam/build_service_account"
