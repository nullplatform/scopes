#!/bin/bash


log debug "🔍 Rolling back traffic to previous deployment..."

np_naming_apply_to_context || exit 1

log debug "📋 Current deployment: $NEW_DEPLOYMENT_ID"
log debug "📋 Rollback target: $DEPLOYMENT_ID"

log debug "📝 Creating ingress for rollback deployment..."

source "$SERVICE_PATH/deployment/networking/gateway/route_traffic"

export DEPLOYMENT_ID=$NEW_DEPLOYMENT_ID

CONTEXT="$ORIGINAL_CONTEXT"

log info "✅ Traffic rollback configuration created"
