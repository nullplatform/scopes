#!/bin/bash

echo "Executing deployment action=$SERVICE_ACTION for scope=$SCOPE_ID and deployment=$DEPLOYMENT_ID"

ACTION_TO_EXECUTE=""

case "$SERVICE_ACTION" in
  "start-initial")
    ACTION_TO_EXECUTE="initial"
    ;;
  "start-blue-green")
  ACTION_TO_EXECUTE="blue_green"
    ;;
  "switch-traffic")
    ACTION_TO_EXECUTE="switch_traffic"
    ;;
  "rollback-deployment")
    ACTION_TO_EXECUTE="rollback"
    ;;
  "finalize-blue-green")
    ACTION_TO_EXECUTE="finalize"
    ;;
  "delete-deployment")
    ACTION_TO_EXECUTE="delete"
    ;;
  "diagnose-deployment")
    ACTION_TO_EXECUTE="diagnose"
    ;;
  "kill-instance")
    ACTION_TO_EXECUTE="kill_instance"
    ;;
  *)
    echo "Unknown action: $SERVICE_ACTION"
    exit 1
    ;;
esac

# The platform re-delivers an action when the agent or worker running it dies,
# and a delivery can also arrive late. If the deployment already reached a
# status that this action leads to, its effect is in place: end successfully
# without running the workflow, instead of failing on an unexpected status or
# re-applying it. Statuses that are merely incompatible (failed, another
# action's) are left to the workflow, which rejects them as before.
done_statuses_for() {
  case "$1" in
    start-initial|start-blue-green|switch-traffic) echo "finalizing finalized" ;;
    finalize-blue-green) echo "finalized" ;;
    rollback-deployment) echo "rolled_back cancelled" ;;
    delete-deployment) echo "deleted" ;;
  esac
}

DONE_STATUSES=$(done_statuses_for "$SERVICE_ACTION")
if [[ -n "$DONE_STATUSES" && -n "${DEPLOYMENT_ID:-}" ]]; then
  # A failed read falls through to the workflow: never skip on a guess.
  CURRENT_STATUS=$(np deployment read --id "$DEPLOYMENT_ID" ${NP_API_KEY:+--api-key "$NP_API_KEY"} --query .status 2>/dev/null) || CURRENT_STATUS=""
  if [[ -n "$CURRENT_STATUS" && " $DONE_STATUSES " == *" $CURRENT_STATUS "* ]]; then
    echo "Deployment $DEPLOYMENT_ID is already '$CURRENT_STATUS': action $SERVICE_ACTION was already applied, nothing to do"
    exit 0
  fi
fi

WORKFLOW_PATH="$SERVICE_PATH/deployment/workflows/$ACTION_TO_EXECUTE.yaml"

NEEDS_PARAMS=true
case "$SERVICE_ACTION" in
  "switch-traffic"|"kill-instance"|"diagnose-deployment")
    NEEDS_PARAMS=false
    ;;
esac

CMD="np service workflow exec --workflow $WORKFLOW_PATH --build-context --include-secrets"

if [ "$NEEDS_PARAMS" = "false" ] && np service workflow exec --help 2>&1 | grep -q "\-\-no-params"; then
  CMD="$CMD --no-params"
fi

IFS=',' read -ra OVERRIDE_PATHS <<< "$OVERRIDES_PATH"
for path in "${OVERRIDE_PATHS[@]}"; do
  # Trim whitespace
  path=$(echo "$path" | xargs)
  OVERRIDE_WORKFLOW_PATH="$path/deployment/workflows/$ACTION_TO_EXECUTE.yaml"
  if [[ -f "$OVERRIDE_WORKFLOW_PATH" ]]; then
    CMD="$CMD --overrides $OVERRIDE_WORKFLOW_PATH"
  fi
done

echo "Executing command: $CMD"
eval $CMD
