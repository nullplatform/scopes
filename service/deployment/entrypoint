#!/bin/bash

echo "Executing deployment action=$SERVICE_ACTION for scope=$SCOPE_ID and deployment=$DEPLOYMENT_ID"

ACTION_TO_EXECUTE=""

case "$SERVICE_ACTION" in
  "start-initial")
    ACTION_TO_EXECUTE="initial"
    ;;
  "start-blue-green")
  ACTION_TO_EXECUTE="blue_green"
    ;;
  "switch-traffic")
    ACTION_TO_EXECUTE="switch_traffic"
    ;;
  "rollback-deployment")
    ACTION_TO_EXECUTE="rollback"
    ;;
  "finalize-blue-green")
    ACTION_TO_EXECUTE="finalize"
    ;;
  "delete-deployment")
    ACTION_TO_EXECUTE="delete"
    ;;
  "diagnose-deployment")
    ACTION_TO_EXECUTE="diagnose"
    ;;
  "kill-instance")
    ACTION_TO_EXECUTE="kill_instance"
    ;;
  *)
    echo "Unknown action: $SERVICE_ACTION"
    exit 1
    ;;
esac

# shellcheck source=/dev/null
source "$SERVICE_PATH/deployment/deployment_status"

exit_if_already_applied() {
  [[ -n "$(deployment_action_applied_statuses "$SERVICE_ACTION")" && -n "${DEPLOYMENT_ID:-}" ]] || return 0
  deployment_status_read
  case $? in
    "$DS_OK")
      if deployment_action_already_applied "$SERVICE_ACTION" "$DEPLOYMENT_STATUS"; then
        echo "Deployment $DEPLOYMENT_ID is already '$DEPLOYMENT_STATUS': action $SERVICE_ACTION was already applied, nothing to do"
        exit 0
      fi
      ;;
    "$DS_CLI_ERROR")
      echo "❌ Could not read the status of deployment $DEPLOYMENT_ID: $DEPLOYMENT_STATUS_ERROR"
      exit 1
      ;;
    "$DS_NO_STATUS")
      echo "❌ Could not read the status of deployment $DEPLOYMENT_ID: no status in the response"
      exit 1
      ;;
  esac
}

exit_if_already_applied

WORKFLOW_PATH="$SERVICE_PATH/deployment/workflows/$ACTION_TO_EXECUTE.yaml"

NEEDS_PARAMS=true
case "$SERVICE_ACTION" in
  "switch-traffic"|"kill-instance"|"diagnose-deployment")
    NEEDS_PARAMS=false
    ;;
esac

CMD="np service workflow exec --workflow $WORKFLOW_PATH --build-context --include-secrets"

if [ "$NEEDS_PARAMS" = "false" ] && np service workflow exec --help 2>&1 | grep -q "\-\-no-params"; then
  CMD="$CMD --no-params"
fi

IFS=',' read -ra OVERRIDE_PATHS <<< "$OVERRIDES_PATH"
for path in "${OVERRIDE_PATHS[@]}"; do
  # Trim whitespace
  path=$(echo "$path" | xargs)
  OVERRIDE_WORKFLOW_PATH="$path/deployment/workflows/$ACTION_TO_EXECUTE.yaml"
  if [[ -f "$OVERRIDE_WORKFLOW_PATH" ]]; then
    CMD="$CMD --overrides $OVERRIDE_WORKFLOW_PATH"
  fi
done

LOCK_LIB="$SERVICE_PATH/deployment/deployment_lock"
if [[ -f "$LOCK_LIB" && -n "${SCOPE_ID:-}" ]] && command -v kubectl >/dev/null 2>&1; then
  # shellcheck source=/dev/null
  source "$LOCK_LIB"
fi
if command -v deployment_lock_applies >/dev/null 2>&1 && deployment_lock_applies "$SERVICE_ACTION"; then
  export NP_DEPLOY_LOCK_HOLDER="${HOSTNAME:-worker}.$$.${RANDOM}${RANDOM}"
  NP_DEPLOY_LOCK_NAMESPACE="$(deployment_lock_namespace)"
  export NP_DEPLOY_LOCK_NAMESPACE
  deployment_lock_try_acquire
  if [ $? -eq 1 ]; then
    LOCK_WAIT_CMD="np service workflow exec --no-output --workflow $SERVICE_PATH/deployment/workflows/lock_wait.yaml --build-context --include-secrets"
    if np service workflow exec --help 2>&1 | grep -q "\-\-no-params"; then
      LOCK_WAIT_CMD="$LOCK_WAIT_CMD --no-params"
    fi
    echo "Another action is running on scope $SCOPE_ID, waiting for it: $LOCK_WAIT_CMD"
    eval $LOCK_WAIT_CMD || exit 1
  fi

  if deployment_lock_held; then
    deployment_lock_renew_loop &
    LOCK_RENEWER=$!
    # shellcheck disable=SC2154
    trap 'rc=$?; kill "$LOCK_RENEWER" 2>/dev/null; deployment_lock_release; exit "$rc"' EXIT

    exit_if_already_applied
  else
    echo "Deployment lock not available on scope $SCOPE_ID: running without it"
  fi
fi

echo "Executing command: $CMD"
eval $CMD
