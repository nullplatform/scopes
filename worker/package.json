{
  "name": "scopes-worker",
  "version": "0.0.0",
  "description": "The worker of the scopes: telemetry answered on the cluster, every other action run by the bash entrypoint",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "describe": "bun src/index.ts --describe",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun build --compile src/index.ts --outfile dist/worker"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.1",
    "@nullplatform/plugin": "^0.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
